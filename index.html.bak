        },
        {
          id: 5,
          name: "Mustard Gold Gota Patti Festive Choli Set",
          sku: "PMH-FC-505",
          category: "Lehenga Choli",
          collection: "Festive Wear",
          fabric: "Chanderi Silk & Mulmul Lining",
