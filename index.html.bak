      function changeProductStatus(id, newStatus) {
        const products = getProducts();
        const prod = products.find(p => p.id === id);
        if (prod) {
          prod.availability = newStatus;
          setProducts(products);
          renderCatalogue();
          showToast(`Status for "${prod.name}" changed to ${newStatus}`);
        }
      }

      // ==========================================
      // BULLETPROOF DRAG & DROP PHOTO ENGINE (ZERO DATABASE REQUIRED)
      // ==========================================
      let activeProductPhotos = [];

      function setupDropzoneEvents() {
        const dropzone = document.getElementById("product-dropzone");
        if (!dropzone || dropzone.dataset.initialized) return;
        dropzone.dataset.initialized = "true";

        ['dragenter', 'dragover'].forEach(eventName => {
          dropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropzone.classList.add("drag-over");
          }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
          dropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropzone.classList.remove("drag-over");
          }, false);
        });

        dropzone.addEventListener("drop", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const dt = e.dataTransfer;
          if (dt && dt.files && dt.files.length > 0) {
            handleProductFiles(dt.files);
          }
        }, false);
      }

      // Automatically downscales large camera/mobile photos so they fit permanently into browser LocalStorage
      function optimizeImageFile(file) {
        return new Promise((resolve) => {
          if (!file) return resolve("");
          const reader = new FileReader();
          reader.onload = function(readerEvent) {
            const rawDataUrl = readerEvent.target.result;
            if (!rawDataUrl || typeof rawDataUrl !== "string") return resolve("");

            const image = new Image();
            image.onload = function() {
              try {
                const maxDim = 800; // Perfect balanced resolution for catalogue speed & quality
                let width = image.width;
                let height = image.height;

                if (width > height) {
                  if (width > maxDim) {
                    height = Math.round((height * maxDim) / width);
                    width = maxDim;
                  }
                } else {
                  if (height > maxDim) {
                    width = Math.round((width * maxDim) / height);
                    height = maxDim;
                  }
                }

                const canvas = document.createElement("canvas");
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext("2d");
                ctx.imageSmoothingEnabled = true;
                ctx.imageSmoothingQuality = "high";
                ctx.drawImage(image, 0, 0, width, height);

                // Compress to compact high-quality JPEG (~40KB - 80KB)
                const dataUrl = canvas.toDataURL("image/jpeg", 0.76);
                resolve(dataUrl);
              } catch(canvasErr) {
                console.warn("Canvas compression fallback:", canvasErr);
                resolve(rawDataUrl);
              }
            };
            image.onerror = function() {
              // If image decode fails, still return raw Data URL
              resolve(rawDataUrl);
            };
            image.src = rawDataUrl;
          };
          reader.onerror = function() {
            console.error("FileReader failed");
            resolve("");
          };
          reader.readAsDataURL(file);
        });
      }

      async function handleProductFiles(files) {
        if (!files || files.length === 0) return;
        showToast(`Reading ${files.length} photo(s)...`);

        let count = 0;
        for (let i = 0; i < files.length; i++) {
          const file = files[i];
          try {
            const dataUrl = await optimizeImageFile(file);
            if (dataUrl) {
              activeProductPhotos.push(dataUrl);
              count++;
            }
          } catch(err) {
            console.error("Image processing error:", err);
          }
        }

        renderProductPhotoPreviews();
        const fileInput = document.getElementById("ap-file-input");
        if (fileInput) fileInput.value = "";

        if (count > 0) {
          showToast(`✓ ${count} photo(s) uploaded & ready! Click SAVE below.`, "fa-circle-check");
        } else {
          showToast("Could not process selected file.", "fa-triangle-exclamation");
        }
      }

      function renderProductPhotoPreviews() {
        const grid = document.getElementById("ap-preview-grid");
        const counter = document.getElementById("ap-photo-counter");
        if (!grid) return;

        if (counter) {
          counter.innerText = `${activeProductPhotos.length} photo(s) selected`;
        }

        if (activeProductPhotos.length === 0) {
          grid.innerHTML = "";
          return;
        }

        grid.innerHTML = activeProductPhotos.map((src, idx) => `
          <div class="photo-preview-card ${idx === 0 ? 'is-cover' : ''}">
            <img src="${src}" alt="Preview ${idx + 1}" />
            ${idx === 0 ? '<span class="photo-cover-badge"><i class="fa-solid fa-star"></i> Cover Photo</span>' : ''}
            <div class="photo-card-actions">
              ${idx !== 0 ? `<button type="button" class="photo-action-btn" title="Set as Main Cover Photo" onclick="App.setCoverPhoto(${idx})"><i class="fa-solid fa-star"></i> Cover</button>` : '<span></span>'}
              <button type="button" class="photo-action-btn btn-delete" title="Delete Photo" onclick="App.removeUploadedPhoto(${idx})"><i class="fa-solid fa-trash"></i></button>
            </div>
          </div>
        `).join("");

        // Sync manual URL only if non-data web url
        const apImg = document.getElementById("ap-image");
        if (apImg) {
          if (activeProductPhotos[0] && !activeProductPhotos[0].startsWith("data:")) {
            apImg.value = activeProductPhotos[0];
          } else {
            apImg.value = "";
          }
        }
      }

      function setCoverPhoto(idx) {
        if (idx <= 0 || idx >= activeProductPhotos.length) return;
        const item = activeProductPhotos.splice(idx, 1)[0];
        activeProductPhotos.unshift(item);
        renderProductPhotoPreviews();
        showToast("Primary Cover Photo updated!", "fa-star");
      }

      function removeUploadedPhoto(idx) {
        if (idx < 0 || idx >= activeProductPhotos.length) return;
        activeProductPhotos.splice(idx, 1);
        renderProductPhotoPreviews();
        showToast("Photo removed.");
      }

      function toggleManualUrlInputs() {
        const c = document.getElementById("manual-url-container");
        if (c) c.style.display = (c.style.display === "none" || !c.style.display) ? "block" : "none";
      }

      function handleManualUrlChange() {
        const u1 = document.getElementById("ap-image").value.trim();
        const u2 = document.getElementById("ap-image2").value.trim();
        if (u1 && !u1.startsWith("[Local")) {
          if (!activeProductPhotos.includes(u1)) activeProductPhotos.unshift(u1);
        }
        if (u2 && !u2.startsWith("[Local")) {
          if (!activeProductPhotos.includes(u2)) activeProductPhotos.push(u2);
        }
        renderProductPhotoPreviews();
      }

      function exportProductsBackup() {
        const data = {
          version: "1.0",
          exportDate: new Date().toISOString(),
          business: "Payal Manufacturing Hub",
          products: getProducts(),
          settings: getSettings()
        };
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `payal_hub_catalogue_backup_${new Date().toISOString().slice(0,10)}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showToast("Complete Catalogue Database backed up successfully!", "fa-circle-down");
      }

      function importProductsBackup(e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(evt) {
          try {
            const parsed = JSON.parse(evt.target.result);
            if (parsed && Array.isArray(parsed.products)) {
              if (confirm(`Found ${parsed.products.length} products in backup file. Do you want to restore and overwrite the current catalogue?`)) {
                setProducts(parsed.products);
                if (parsed.settings) setSettings(parsed.settings);
                renderAdminProductsTable();
                renderCatalogue();
                showToast(`Restored ${parsed.products.length} products successfully!`, "fa-circle-check");
              }
            } else if (Array.isArray(parsed)) {
              if (confirm(`Found ${parsed.length} products in JSON file. Restore to catalogue?`)) {
                setProducts(parsed);
                renderAdminProductsTable();
                renderCatalogue();
                showToast(`Restored ${parsed.length} products successfully!`, "fa-circle-check");
              }
            } else {
              showToast("Invalid JSON backup structure.", "fa-triangle-exclamation");
            }
          } catch(err) {
            showToast("Failed to parse JSON file.", "fa-triangle-exclamation");
          }
        };
        reader.readAsText(file);
      }

      function openAddProductModal() {
        document.getElementById("prod-modal-heading").innerText = "Add New Masterpiece";
        document.getElementById("admin-prod-id").value = "";
        document.getElementById("ap-name").value = "";
        document.getElementById("ap-category").value = "Lehenga Choli";
        activeProductPhotos = [];
        renderProductPhotoPreviews();
        const apImg = document.getElementById("ap-image");
        if (apImg) apImg.value = "";
        const apImg2 = document.getElementById("ap-image2");
        if (apImg2) apImg2.value = "";
        document.getElementById("ap-fabric").value = "";
        document.getElementById("ap-work").value = "";
        document.getElementById("ap-color").value = "";
        document.getElementById("ap-occasion").value = "Bridal / Wedding";
        document.getElementById("ap-desc").value = "";
        document.getElementById("ap-status").value = "Available";
        document.getElementById("ap-price-visibility").value = "enquiry";
        document.getElementById("ap-wholesale-chk").checked = true;
        document.getElementById("ap-retail-chk").checked = true;

        document.getElementById("admin-product-modal").classList.add("show");
        setupDropzoneEvents();
      }

      function openEditProductModal(id) {
        const prod = getProducts().find(p => p.id === id);
        if (!prod) return;

        document.getElementById("prod-modal-heading").innerText = `Edit: ${prod.name}`;
        document.getElementById("admin-prod-id").value = prod.id;
        document.getElementById("ap-name").value = prod.name;
        document.getElementById("ap-category").value = prod.category;
        
        // Populate existing photos
        activeProductPhotos = [];
        if (prod.gallery && Array.isArray(prod.gallery) && prod.gallery.length > 0) {
          activeProductPhotos = [...prod.gallery];
        } else if (prod.image) {
          activeProductPhotos = [prod.image];
        }
        renderProductPhotoPreviews();

        const apImg = document.getElementById("ap-image");
        if (apImg) apImg.value = (prod.image && !prod.image.startsWith("data:")) ? prod.image : "";
        const apImg2 = document.getElementById("ap-image2");
        if (apImg2) apImg2.value = (prod.gallery && prod.gallery[1] && !prod.gallery[1].startsWith("data:")) ? prod.gallery[1] : "";

        document.getElementById("ap-fabric").value = prod.fabric;
        document.getElementById("ap-work").value = prod.work;
        document.getElementById("ap-color").value = prod.color;
        document.getElementById("ap-occasion").value = prod.occasion;
        document.getElementById("ap-desc").value = prod.description || "";
        document.getElementById("ap-status").value = prod.availability;
        document.getElementById("ap-price-visibility").value = prod.priceVisibility || "enquiry";
        document.getElementById("ap-wholesale-chk").checked = prod.wholesale;
        document.getElementById("ap-retail-chk").checked = prod.retail;

        document.getElementById("admin-product-modal").classList.add("show");
        setupDropzoneEvents();
      }

      function saveProduct(e) {
        e.preventDefault();
        const idVal = document.getElementById("admin-prod-id").value;
        const products = getProducts();

        let primaryImg = "";
        let gallery = [];

        if (activeProductPhotos.length > 0) {
          primaryImg = activeProductPhotos[0];
          gallery = [...activeProductPhotos];
        } else {
          // Check manual URL inputs
          const u1 = document.getElementById("ap-image").value.trim();
          const u2 = document.getElementById("ap-image2").value.trim();
          if (u1 && !u1.startsWith("[Local")) {
            primaryImg = u1;
            gallery.push(u1);
            if (u2 && !u2.startsWith("[Local")) gallery.push(u2);
          } else {
            // Default placeholder if none provided
            primaryImg = "https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=800&q=80";
            gallery = [primaryImg];
          }
        }

        if (idVal) {
          // Edit existing
          const idx = products.findIndex(p => p.id === parseInt(idVal));
          if (idx !== -1) {
            products[idx].name = document.getElementById("ap-name").value.trim();
            products[idx].category = document.getElementById("ap-category").value;
            products[idx].collection = document.getElementById("ap-category").value;
            products[idx].image = primaryImg;
            products[idx].gallery = gallery;
            products[idx].fabric = document.getElementById("ap-fabric").value.trim();
            products[idx].work = document.getElementById("ap-work").value.trim();
            products[idx].color = document.getElementById("ap-color").value.trim();
            products[idx].occasion = document.getElementById("ap-occasion").value.trim();
            products[idx].description = document.getElementById("ap-desc").value.trim();
            products[idx].availability = document.getElementById("ap-status").value;
            products[idx].priceVisibility = document.getElementById("ap-price-visibility").value;
            products[idx].wholesale = document.getElementById("ap-wholesale-chk").checked;
            products[idx].retail = document.getElementById("ap-retail-chk").checked;
          }
          showToast("Product updated successfully!", "fa-circle-check");
        } else {
          // Create new
          const newId = Date.now();
          const newProduct = {
            id: newId,
            name: document.getElementById("ap-name").value.trim(),
            sku: "PMH-NEW-" + Math.floor(100 + Math.random() * 900),
            category: document.getElementById("ap-category").value,
            collection: document.getElementById("ap-category").value,
            image: primaryImg,
            gallery: gallery,
            fabric: document.getElementById("ap-fabric").value.trim(),
            work: document.getElementById("ap-work").value.trim(),
            color: document.getElementById("ap-color").value.trim(),
            occasion: document.getElementById("ap-occasion").value.trim(),
            sizes: "Standard Semi-stitched",
            description: document.getElementById("ap-desc").value.trim(),
            availability: document.getElementById("ap-status").value,
            priceVisibility: document.getElementById("ap-price-visibility").value,
            wholesale: document.getElementById("ap-wholesale-chk").checked,
            retail: document.getElementById("ap-retail-chk").checked
          };
          products.unshift(newProduct);
          showToast(`✓ "${newProduct.name}" added & published to catalogue!`, "fa-circle-check");
        }

        setProducts(products);
        activeProductPhotos = [];
        closeModals();
        renderAdminProductsTable();
        renderCatalogue();
        renderAdminOverview();
      }

      function duplicateProduct(id) {
        const products = getProducts();
        const prod = products.find(p => p.id === id);
        if (!prod) return;

        const clone = JSON.parse(JSON.stringify(prod));
        clone.id = Date.now();
        clone.sku = "PMH-CLONE-" + Math.floor(100 + Math.random() * 900);
        clone.name = prod.name + " (Copy)";
        products.unshift(clone);
        setProducts(products);
        renderAdminProductsTable();
        renderCatalogue();
        showToast(`Duplicated: ${clone.name}`);
      }

      function deleteProduct(id) {
        if (!confirm("Are you sure you want to remove this product from the live catalogue?")) return;
        let products = getProducts();
        products = products.filter(p => p.id !== id);
        setProducts(products);
        renderAdminProductsTable();
        renderCatalogue();
        showToast("Product deleted from database.");
      }

      function renderAdminEnquiriesTable() {
        const tbody = document.getElementById("admin-enquiries-table-body");
        if (!tbody) return;
        const enquiries = getEnquiries();

        if (enquiries.length === 0) {
          tbody.innerHTML = `<tr><td colspan="9" style="text-align:center; padding:30px; color:var(--text-muted);">No enquiries in database.</td></tr>`;
          return;
        }

        tbody.innerHTML = enquiries.map(enq => `
          <tr>
            <td><strong>${enq.id}</strong></td>
            <td>${enq.customerName}</td>
            <td><a href="tel:${enq.mobileNumber}" style="color:var(--maroon-royal); font-weight:700;">${enq.mobileNumber}</a></td>
            <td>${enq.emailAddress || '—'}</td>
            <td>${enq.productName}</td>
            <td>${enq.quantity}</td>
            <td><span class="badge-luxury">${enq.requirementType}</span></td>
            <td>
              <select onchange="App.changeEnquiryStatus('${enq.id}', this.value)" style="padding:4px 8px; font-size:0.78rem; border-radius:4px; border:1px solid var(--gold-border);">
                <option value="New" ${enq.status === 'New' ? 'selected' : ''}>New</option>
                <option value="Contacted" ${enq.status === 'Contacted' ? 'selected' : ''}>Contacted</option>
                <option value="In Discussion" ${enq.status === 'In Discussion' ? 'selected' : ''}>In Discussion</option>
                <option value="Converted" ${enq.status === 'Converted' ? 'selected' : ''}>Converted</option>
                <option value="Closed" ${enq.status === 'Closed' ? 'selected' : ''}>Closed</option>
              </select>
            </td>
            <td>
              <div style="display:flex; gap:6px;">
                <a href="https://wa.me/${enq.mobileNumber.replace(/[^0-9]/g, '')}?text=Hello%20${encodeURIComponent(enq.customerName)},%20this%20is%20Payal%20Manufacturing%20Hub%20Mumbai%20regarding%20your%20enquiry%20for%20${encodeURIComponent(enq.productName)}." target="_blank" class="btn btn-sm btn-whatsapp" style="padding:4px 8px;" title="WhatsApp Customer"><i class="fa-brands fa-whatsapp"></i></a>
                <a href="tel:${enq.mobileNumber}" class="btn btn-sm btn-outline-gold" style="padding:4px 8px;" title="Call"><i class="fa-solid fa-phone"></i></a>
              </div>
            </td>
          </tr>
        `).join("");
      }

      function changeEnquiryStatus(id, newStatus) {
        const enquiries = getEnquiries();
        const enq = enquiries.find(e => e.id === id);
        if (enq) {
          enq.status = newStatus;
          setEnquiries(enquiries);
          showToast(`Enquiry ${id} status set to ${newStatus}`);
        }
      }

      function renderAdminWholesaleTable() {
        const tbody = document.getElementById("admin-wholesale-table-body");
        if (!tbody) return;
        const leads = getWholesaleLeads();

        if (leads.length === 0) {
          tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:30px; color:var(--text-muted);">No wholesale leads submitted yet.</td></tr>`;
          return;
        }

        tbody.innerHTML = leads.map(l => `
          <tr>
            <td>${l.date}</td>
            <td><strong>${l.businessName}</strong><br><small>${l.customerName}</small></td>
            <td><a href="tel:${l.mobileNumber}">${l.mobileNumber}</a></td>
            <td>${l.city}, ${l.state}</td>
            <td><span class="badge-luxury badge-gold">${l.productCategory}</span></td>
            <td>${l.approxQuantity}</td>
            <td>
              <select onchange="App.changeWholesaleStatus('${l.id}', this.value)" style="padding:4px 8px; font-size:0.78rem; border-radius:4px;">
                <option value="New" ${l.status === 'New' ? 'selected' : ''}>New</option>
                <option value="Contacted" ${l.status === 'Contacted' ? 'selected' : ''}>Contacted</option>
                <option value="In Discussion" ${l.status === 'In Discussion' ? 'selected' : ''}>In Discussion</option>
                <option value="Converted" ${l.status === 'Converted' ? 'selected' : ''}>Converted</option>
                <option value="Closed" ${l.status === 'Closed' ? 'selected' : ''}>Closed</option>
              </select>
            </td>
            <td>
              <a href="https://wa.me/${l.mobileNumber.replace(/[^0-9]/g, '')}?text=Hello%20${encodeURIComponent(l.customerName)},%20we%20have%20reviewed%20the%20wholesale%20request%20for%20${encodeURIComponent(l.businessName)}." target="_blank" class="btn btn-sm btn-whatsapp"><i class="fa-brands fa-whatsapp"></i> Chat</a>
            </td>
          </tr>
        `).join("");
      }

      function changeWholesaleStatus(id, newStatus) {
        const leads = getWholesaleLeads();
        const l = leads.find(item => item.id === id);
        if (l) {
          l.status = newStatus;
          setWholesaleLeads(leads);
          showToast(`Wholesale lead ${id} status updated to ${newStatus}`);
        }
      }

      function renderAdminCustomersTable() {
        const tbody = document.getElementById("admin-customers-table-body");
        if (!tbody) return;
        const customers = getCustomers();

        tbody.innerHTML = customers.map(c => `
          <tr>
            <td><strong>${c.name}</strong></td>
            <td>${c.phone}</td>
            <td>${c.email}</td>
            <td>${c.city || 'Mumbai'}</td>
            <td><span class="badge-luxury">${c.type || 'Retail'}</span></td>
            <td>${c.date || 'Active'}</td>
          </tr>
        `).join("");
      }

      function renderAdminEmailLogsTable() {
        const tbody = document.getElementById("admin-email-logs-body");
        if (!tbody) return;
        const logs = getEmailLogs();

        if (logs.length === 0) {
          tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; padding:30px; color:var(--text-muted);">No outgoing email logs in queue. Any new login, registration, or enquiry automatically records here.</td></tr>`;
          return;
        }

        tbody.innerHTML = logs.map(l => `
          <tr>
            <td style="font-size:0.75rem; white-space:nowrap;">${l.time}</td>
            <td><strong>${l.recipient}</strong></td>
            <td><span class="badge-luxury badge-gold">${l.eventType}</span><br><small>${l.subject}</small></td>
            <td>
              <pre style="white-space:pre-wrap; font-family:var(--font-body); font-size:0.78rem; background:var(--bg-cream); padding:8px; border-radius:4px; max-width:400px;">${l.body}</pre>
            </td>
          </tr>
        `).join("");
      }

      function clearEmailLogs() {
        setEmailLogs([]);
        renderAdminEmailLogsTable();
        showToast("Email logs cleared.");
      }

      function populateAdminSettingsForm() {
        const s = getSettings();
        document.getElementById("set-business-name").value = s.businessName;
        document.getElementById("set-tagline").value = s.tagline;
        document.getElementById("set-phone").value = s.phone;
        document.getElementById("set-email").value = s.email;
        document.getElementById("set-gstin").value = s.gstin;
        document.getElementById("set-city-state").value = s.cityState || "Mumbai, Maharashtra";
        document.getElementById("set-address").value = s.address;
        document.getElementById("set-hero-headline").value = s.heroHeadline;
        document.getElementById("set-hero-desc").value = s.heroDesc;
      }

      function saveWebsiteSettings(e) {
        e.preventDefault();
        const newSettings = {
          businessName: document.getElementById("set-business-name").value.trim(),
          tagline: document.getElementById("set-tagline").value.trim(),
          phone: document.getElementById("set-phone").value.trim(),
          whatsapp: document.getElementById("set-phone").value.trim(),
          email: document.getElementById("set-email").value.trim(),
          gstin: document.getElementById("set-gstin").value.trim(),
          cityState: document.getElementById("set-city-state").value.trim(),
          address: document.getElementById("set-address").value.trim(),
          heroHeadline: document.getElementById("set-hero-headline").value.trim(),
          heroDesc: document.getElementById("set-hero-desc").value.trim()
        };

        setSettings(newSettings);
        applySettingsToDOM();
        showToast("Website Settings updated & applied live!");
      }

      function applySettingsToDOM() {
        const s = getSettings();
        // Top bar
        const topPhone = document.getElementById("top-phone-link");
        if (topPhone) { topPhone.href = `tel:${s.phone.replace(/\s+/g, '')}`; topPhone.innerHTML = `<i class="fa-solid fa-phone"></i> ${s.phone}`; }
        const topEmail = document.getElementById("top-email-link");
        if (topEmail) { topEmail.href = `mailto:${s.email}`; topEmail.innerHTML = `<i class="fa-solid fa-envelope"></i> ${s.email}`; }
        const topGstin = document.getElementById("top-gstin-text");
        if (topGstin) topGstin.innerText = s.gstin;

        // Hero
        const heroTag = document.getElementById("hero-tagline-display");
        if (heroTag) heroTag.innerText = s.tagline;
        const heroDesc = document.getElementById("hero-desc-display");
        if (heroDesc) heroDesc.innerText = s.heroDesc;

        // Contact
        const cAddr = document.getElementById("contact-address-text");
        if (cAddr) cAddr.innerText = s.address;
        const cPhone = document.getElementById("contact-phone-link");
        if (cPhone) { cPhone.href = `tel:${s.phone.replace(/\s+/g, '')}`; cPhone.innerText = s.phone; }
        const cEmail = document.getElementById("contact-email-link");
        if (cEmail) { cEmail.href = `mailto:${s.email}`; cEmail.innerText = s.email; }
        const cGstin = document.getElementById("contact-gstin-text");
        if (cGstin) cGstin.innerText = s.gstin;

        // Footer
        const fTag = document.getElementById("footer-tagline-text");
        if (fTag) fTag.innerText = s.tagline;
        const fAddr = document.getElementById("footer-address-text");
        if (fAddr) fAddr.innerText = s.address;
        const fPhone = document.getElementById("footer-phone-link");
        if (fPhone) { fPhone.href = `tel:${s.phone.replace(/\s+/g, '')}`; fPhone.innerText = s.phone; }
        const fEmail = document.getElementById("footer-email-link");
        if (fEmail) { fEmail.href = `mailto:${s.email}`; fEmail.innerText = s.email; }
        const fGstin = document.getElementById("footer-gstin-text");
        if (fGstin) fGstin.innerText = s.gstin;
      }

      // ==========================================
      // SPA ROUTER & NAVIGATION
      // ==========================================
      function navigateTo(view) {
        window.scrollTo({ top: 0, behavior: "smooth" });
        const publicMain = document.getElementById("public-main-content");
        const custView = document.getElementById("customer-dashboard-view");
        const adminView = document.getElementById("admin-dashboard-view");

        // Close mobile nav
        document.getElementById("main-nav-links").classList.remove("mobile-open");

        if (view === 'customer-dashboard') {
          publicMain.style.display = "none";
          custView.classList.add("active");
          adminView.classList.remove("active");
          renderCustomerDashboard();
        } else if (view === 'admin-dashboard') {
          publicMain.style.display = "none";
          custView.classList.remove("active");
          adminView.classList.add("active");
          renderAdminDashboard();
        } else {
          // Public Home
          publicMain.style.display = "block";
          custView.classList.remove("active");
          adminView.classList.remove("active");

          if (view && view !== 'home') {
            const targetEl = document.getElementById(view);
            if (targetEl) targetEl.scrollIntoView({ behavior: "smooth" });
          }
        }
      }

      function toggleMobileMenu() {
        const nav = document.getElementById("main-nav-links");
        nav.classList.toggle("mobile-open");
      }

      function closeModals() {
        document.querySelectorAll(".modal-backdrop").forEach(m => m.classList.remove("show"));
      }

      // Close modal on click outside
      window.addEventListener("click", (e) => {
        if (e.target.classList.contains("modal-backdrop")) {
          closeModals();
        }
      });

      // Sticky Header Scroll effect & 3D Hero tilt
      window.addEventListener("scroll", () => {
        const header = document.getElementById("site-header");
        if (window.scrollY > 40) {
          header.classList.add("scrolled");
        } else {
          header.classList.remove("scrolled");
        }
      });

      // Subtle 3D Card tilt on Desktop
      const heroCard = document.getElementById("hero-tilt-card");
      if (heroCard) {
        heroCard.addEventListener("mousemove", (e) => {
          const rect = heroCard.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          heroCard.style.transform = `perspective(1000px) rotateY(${x / 25}deg) rotateX(${-y / 25}deg) translateY(-4px)`;
        });
        heroCard.addEventListener("mouseleave", () => {
          heroCard.style.transform = `perspective(1000px) rotateY(0) rotateX(0) translateY(0)`;
        });
      }

      // Initialize Application
      function init() {
        initDatabase();
        applySettingsToDOM();
        renderCatalogue();
        updateWishlistCount();
        setupDropzoneEvents();

        // Dismiss preloader smoothly
        setTimeout(() => {
          const preloader = document.getElementById("luxury-preloader");
          if (preloader) preloader.classList.add("fade-out");
        }, 1200);
      }

      // Public API exposed
      return {
        init: init,
        navigateTo: navigateTo,
        filterCatalogue: filterCatalogue,
        handleSearch: handleSearch,
        focusSearch: focusSearch,
        openProductModal: openProductModal,
        switchDetailThumb: switchDetailThumb,
        openEnquiryForProduct: openEnquiryForProduct,
        openGeneralEnquiryModal: openGeneralEnquiryModal,
        handleProductEnquirySubmit: handleProductEnquirySubmit,
        triggerInstantWhatsAppEnquiry: triggerInstantWhatsAppEnquiry,
        handleWholesaleSubmit: handleWholesaleSubmit,
        handleContactSubmit: handleContactSubmit,
        toggleWishlist: toggleWishlist,
        openWishlistModal: openWishlistModal,
        handleAccountClick: handleAccountClick,
        openCustomerAuthModal: openCustomerAuthModal,
        toggleAuthView: toggleAuthView,
        handleCustomerRegister: handleCustomerRegister,
        handleCustomerLogin: handleCustomerLogin,
        customerLogout: customerLogout,
        switchCustTab: switchCustTab,
        saveCustomerProfile: saveCustomerProfile,
        openAdminLoginModal: openAdminLoginModal,
        toggleAdminPasswordVisibility: toggleAdminPasswordVisibility,
        handleAdminLogin: handleAdminLogin,
        adminLogout: adminLogout,
        switchAdminTab: switchAdminTab,
        openAddProductModal: openAddProductModal,
        openEditProductModal: openEditProductModal,
        saveProduct: saveProduct,
        duplicateProduct: duplicateProduct,
        deleteProduct: deleteProduct,
        changeProductStatus: changeProductStatus,
        changeEnquiryStatus: changeEnquiryStatus,
        changeWholesaleStatus: changeWholesaleStatus,
        clearEmailLogs: clearEmailLogs,
        saveWebsiteSettings: saveWebsiteSettings,
        toggleMobileMenu: toggleMobileMenu,
        closeModals: closeModals,
        handleProductFiles: handleProductFiles,
        setCoverPhoto: setCoverPhoto,
        removeUploadedPhoto: removeUploadedPhoto,
        toggleManualUrlInputs: toggleManualUrlInputs,
        handleManualUrlChange: handleManualUrlChange,
        exportProductsBackup: exportProductsBackup,
        importProductsBackup: importProductsBackup
      };

    })();

    // Boot App on DOMContentLoaded
    document.addEventListener("DOMContentLoaded", () => {
      App.init();
    });
  </script>
</body>
</html>
