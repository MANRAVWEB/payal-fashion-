          fabric: "Pure Katan Silk with Gold Zari",
          work: "Kadwa Hand-weaving with Antique Gold Brocade",
          color: "Vermilion Crimson & Gold",
          occasion: "Bridal / Festive Celebration",
          sizes: "Standard 6.3 Meters with Blouse Piece",
          availability: "Available",
          wholesale: true,
          retail: true,
          priceVisibility: "wholesale",
          priceText: "Contact for Wholesale Price",
          image: "assets/images/prod-banarasi-saree.jpg",
          gallery: [
            "assets/images/prod-banarasi-saree.jpg",
            "assets/images/collection-saree.jpg"
          ],
          description: "Woven in timeless Varanasi tradition with pure tested gold zari. Boasts an intricate floral jaal pattern across the body and an architectural grand pallu."
        },
        {
          id: 3,
          name: "Rose Gold Handcrafted Foil Mirror Lehenga",
          sku: "PMH-PL-309",
          category: "Lehenga Choli",
          collection: "Party Wear",
          fabric: "Pure Viscose Georgette",
          work: "Imported Foil Mirror Work with Silver Dabka",
          color: "Dusty Rose Gold",
          occasion: "Sangeet / Cocktail / Reception",
          sizes: "Semi-stitched (Custom tailoring supported)",
          availability: "Available",
          wholesale: true,
          retail: true,
          priceVisibility: "enquiry",
          priceText: "Price on Enquiry",
          image: "assets/images/prod-mirror-lehenga.jpg",
          gallery: [
            "assets/images/prod-mirror-lehenga.jpg",
            "assets/images/collection-lehenga.jpg"
          ],
          description: "A shimmering showstopper designed for evening celebrations. Lightweight yet lavish, catching ambient light from every angle."
        },
        {
          id: 4,
          name: "Emerald Green Organza Tissue Festive Saree",
          sku: "PMH-SR-412",
          category: "Sarees",
          collection: "Festive Wear",
          fabric: "Sheer Organza Silk Tissue",
          work: "Scalloped Cutwork Border with Thread Embroidery",
          color: "Deep Emerald Green",
          occasion: "Festive / Diwali / Family Occasion",
          sizes: "6.3 Meters with Designer Embroidered Blouse",
          availability: "Available",
          wholesale: true,
          retail: true,
          priceVisibility: "enquiry",
          priceText: "Price on Enquiry",
          image: "assets/images/prod-organza-saree.jpg",
          gallery: [
            "assets/images/prod-organza-saree.jpg",
            "assets/images/collection-festive.jpg"
          ],
