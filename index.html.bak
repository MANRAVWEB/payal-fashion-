  <section class="dashboard-panel-view" id="customer-dashboard-view">
    <div class="container">
      <div class="dashboard-card-wrap">
        <div class="dashboard-header">
          <div>
            <span class="badge-luxury badge-gold">CUSTOMER PORTAL</span>
            <h2 id="cust-welcome-title">Namaste, Customer</h2>
            <p style="font-size:0.8rem; color:#F8F3E2; margin-top:4px;" id="cust-sub-details">Account Type: Retail / Wholesale</p>
          </div>
