          availability: "Available",
          wholesale: true,
          retail: true,
          priceVisibility: "wholesale",
          priceText: "Contact for Wholesale Price",
          image: "assets/images/prod-mustard-choli.jpg",
          gallery: [
            "assets/images/prod-mustard-choli.jpg",
            "assets/images/collection-bridal.jpg"
          ],
          description: "A joyful, radiant ensemble curated specifically for pre-wedding celebrations. Finished with signature handmade tassels and mirror-highlighted dupatta."
        },
        {
          id: 6,
          name: "Peacock Blue Designer Fusion Reception Drape",
          sku: "PMH-DS-601",
          category: "Designer Collections",
          collection: "Designer Collections",
          fabric: "Italian Satin Georgette",
          work: "Cutdana, Bugle Beads & Tone-on-Tone Crystals",
          color: "Royal Peacock Blue",
          occasion: "Reception / Red Carpet / High Glamour",
          sizes: "Ready-to-Wear Pre-draped Option Available",
          availability: "Available",
          wholesale: true,
          retail: true,
          priceVisibility: "enquiry",
          priceText: "Price on Enquiry",
          image: "assets/images/prod-peacock-fusion.jpg",
          gallery: [
            "assets/images/prod-peacock-fusion.jpg",
            "assets/images/collection-designer.jpg"
          ],
          description: "Limited atelier production. Modern silhouette draping that cascades elegantly with heavy hand-encrusted crystal blouse piece."
        },
        {
          id: 7,
          name: "Ivory & Champagne Gold Zari Bridal Ensemble",
          sku: "PMH-BL-707",
          category: "Lehenga Choli",
          collection: "Bridal Wear",
          fabric: "Raw Silk with Tussar Dupatta",
          work: "Fine Marodi, Salma & Pearl Craftsmanship",
          color: "Champagne Cream & Antique Ivory",
          occasion: "Contemporary Wedding / Day Ceremonies",
          sizes: "Semi-stitched (Waist 32\" to 42\")",
          availability: "Available",
          wholesale: true,
          retail: true,
          priceVisibility: "enquiry",
          priceText: "Price on Enquiry",
          image: "assets/images/prod-ivory-bridal.jpg",
          gallery: [
            "assets/images/prod-ivory-bridal.jpg",
            "assets/images/about-craft.jpg"
          ],
          description: "Subtle royalty in ivory and antique gold tones. Designed for brides who appreciate understated luxury and sophisticated color palettes."
        },
        {
          id: 8,
          name: "Pure Paithani Heritage Silk Saree",
          sku: "PMH-SR-808",
          category: "Sarees",
          collection: "Festive Wear",
          fabric: "Pure Mulberry Silk",
          work: "Traditional Peacock & Lotus Weave with Muniya Border",
          color: "Royal Purple & Gold Zari",
          occasion: "Traditional Maharashtrian Weddings / Pujas",
          sizes: "6.3 Meters with Blouse",
          availability: "Available",
          wholesale: true,
          retail: true,
          priceVisibility: "wholesale",
          priceText: "Contact for Wholesale Price",
          image: "assets/images/prod-paithani-saree.jpg",
          gallery: [
            "assets/images/prod-paithani-saree.jpg",
            "assets/images/collection-saree.jpg"
          ],
          description: "An authentic Maharashtra handloom treasure directly from master weavers. Rich zari pallu featuring vibrant mor-butti (peacock motifs)."
        }
      ];

      // Default Site Settings
      const DEFAULT_SETTINGS = {
        businessName: "PAYAL MANUFACTURING HUB",
        tagline: "TRADITION IN EVERY THREAD",
        phone: "+91 8209206788",
        whatsapp: "+91 8209206788",
        email: "Heermanufacturinghub@gmail.com",
        address: "Shop No. 12, Fashion Market, Bhuleshwar Road, Mumbai, Maharashtra – 400002",
        gstin: "27ABCSM8174F1Z5",
        cityState: "Mumbai, Maharashtra",
        heroHeadline: "Tradition Woven Into Every Thread.",
        heroDesc: "Discover premium lehenga choli and saree collections crafted for celebrations, elegance and timeless Indian style. Handcrafted by master artisans with pure fabrics and intricate embroidery."
      };

      // State storage keys
      const STORAGE_KEYS = {
        PRODUCTS: "pmh_products_db",
        SETTINGS: "pmh_settings_db",
        ENQUIRIES: "pmh_enquiries_db",
        WHOLESALE: "pmh_wholesale_db",
        CUSTOMERS: "pmh_customers_db",
        WISHLIST: "pmh_wishlist_db",
        EMAIL_LOGS: "pmh_email_logs_db",
        CURRENT_USER: "pmh_current_user",
        ADMIN_LOGGED: "pmh_admin_logged"
      };

      const DB_VERSION_KEY = "pmh_db_version_v3";

      // Initialize DB in LocalStorage
      function initDatabase() {
        const storedVersion = localStorage.getItem(DB_VERSION_KEY);
        if (storedVersion !== "3.0") {
          localStorage.setItem(STORAGE_KEYS.PRODUCTS, JSON.stringify(DEFAULT_PRODUCTS));
          localStorage.setItem(DB_VERSION_KEY, "3.0");
        } else if (!localStorage.getItem(STORAGE_KEYS.PRODUCTS)) {
          localStorage.setItem(STORAGE_KEYS.PRODUCTS, JSON.stringify(DEFAULT_PRODUCTS));
        }
        if (!localStorage.getItem(STORAGE_KEYS.SETTINGS)) {
          localStorage.setItem(STORAGE_KEYS.SETTINGS, JSON.stringify(DEFAULT_SETTINGS));
        }
        if (!localStorage.getItem(STORAGE_KEYS.ENQUIRIES)) {
          localStorage.setItem(STORAGE_KEYS.ENQUIRIES, JSON.stringify([]));
        }
        if (!localStorage.getItem(STORAGE_KEYS.WHOLESALE)) {
          localStorage.setItem(STORAGE_KEYS.WHOLESALE, JSON.stringify([]));
        }
        if (!localStorage.getItem(STORAGE_KEYS.CUSTOMERS)) {
          localStorage.setItem(STORAGE_KEYS.CUSTOMERS, JSON.stringify([
            { id: 1, name: "Pooja Sharma", phone: "+91 9820112233", email: "pooja.sharma@example.com", city: "Mumbai", type: "Retail", date: "2026-09-20" },
            { id: 2, name: "Rajesh Varma (Varma Sarees)", phone: "+91 9845012345", email: "varma.textiles@example.com", city: "Surat", type: "Wholesale", date: "2026-09-22" }
          ]));
        }
        if (!localStorage.getItem(STORAGE_KEYS.WISHLIST)) {
          localStorage.setItem(STORAGE_KEYS.WISHLIST, JSON.stringify([]));
        }
        if (!localStorage.getItem(STORAGE_KEYS.EMAIL_LOGS)) {
          localStorage.setItem(STORAGE_KEYS.EMAIL_LOGS, JSON.stringify([]));
        }
      }

      // Getters & Setters
      function getProducts() { return JSON.parse(localStorage.getItem(STORAGE_KEYS.PRODUCTS)) || []; }
      function setProducts(p) {
        try {
          localStorage.setItem(STORAGE_KEYS.PRODUCTS, JSON.stringify(p));
        } catch(err) {
          console.warn("Storage quota limit reached, compacting stored catalogue:", err);
          try {
            const compacted = p.map(item => {
              const copy = Object.assign({}, item);
              if (copy.gallery && copy.gallery.length > 2) {
                copy.gallery = copy.gallery.slice(0, 2);
              }
              return copy;
            });
            localStorage.setItem(STORAGE_KEYS.PRODUCTS, JSON.stringify(compacted));
          } catch(err2) {
            console.error("Critical storage error:", err2);
            showToast("Storage quota full! Try exporting database backup and removing old test items.", "fa-triangle-exclamation");
          }
        }
      }

      function getSettings() { return JSON.parse(localStorage.getItem(STORAGE_KEYS.SETTINGS)) || DEFAULT_SETTINGS; }
      function setSettings(s) { localStorage.setItem(STORAGE_KEYS.SETTINGS, JSON.stringify(s)); }

      function getEnquiries() { return JSON.parse(localStorage.getItem(STORAGE_KEYS.ENQUIRIES)) || []; }
      function setEnquiries(e) { localStorage.setItem(STORAGE_KEYS.ENQUIRIES, JSON.stringify(e)); }

      function getWholesaleLeads() { return JSON.parse(localStorage.getItem(STORAGE_KEYS.WHOLESALE)) || []; }
      function setWholesaleLeads(w) { localStorage.setItem(STORAGE_KEYS.WHOLESALE, JSON.stringify(w)); }

      function getCustomers() { return JSON.parse(localStorage.getItem(STORAGE_KEYS.CUSTOMERS)) || []; }
      function setCustomers(c) { localStorage.setItem(STORAGE_KEYS.CUSTOMERS, JSON.stringify(c)); }

      function getWishlist() { return JSON.parse(localStorage.getItem(STORAGE_KEYS.WISHLIST)) || []; }
      function setWishlist(w) { localStorage.setItem(STORAGE_KEYS.WISHLIST, JSON.stringify(w)); }

      function getEmailLogs() { return JSON.parse(localStorage.getItem(STORAGE_KEYS.EMAIL_LOGS)) || []; }
      function setEmailLogs(l) { localStorage.setItem(STORAGE_KEYS.EMAIL_LOGS, JSON.stringify(l)); }

      function getCurrentUser() { return JSON.parse(localStorage.getItem(STORAGE_KEYS.CURRENT_USER)); }
      function setCurrentUser(u) { localStorage.setItem(STORAGE_KEYS.CURRENT_USER, JSON.stringify(u)); }

      function isAdminLoggedIn() { return localStorage.getItem(STORAGE_KEYS.ADMIN_LOGGED) === "true"; }
      function setAdminLoggedIn(v) { localStorage.setItem(STORAGE_KEYS.ADMIN_LOGGED, v ? "true" : "false"); }

      // ==========================================
      // SIMULATED TRANSACTIONAL EMAIL ENGINE
      // ==========================================
      function logSimulatedEmail(eventType, recipient, subject, htmlContent) {
        const logs = getEmailLogs();
        const newLog = {
          id: Date.now(),
          time: new Date().toLocaleString(),
          eventType: eventType,
          recipient: recipient,
          subject: subject,
          body: htmlContent
        };
        logs.unshift(newLog);
        setEmailLogs(logs);
        console.log(`[SIMULATED TRANSACTIONAL EMAIL DISPATCHED] To: ${recipient} | Subject: ${subject}`);
      }

      // Toast Notifications
      function showToast(message, icon = "fa-circle-check") {
        const container = document.getElementById("toast-container");
        if (!container) return;
        const toast = document.createElement("div");
        toast.className = "toast-msg";
        toast.innerHTML = `<i class="fa-solid ${icon}" style="color:var(--maroon-royal); font-size:1.15rem;"></i> <span>${message}</span>`;
        container.appendChild(toast);
        setTimeout(() => {
          toast.style.opacity = "0";
          toast.style.transition = "opacity 0.4s ease";
          setTimeout(() => toast.remove(), 400);
        }, 4000);
      }

      // ==========================================
      // RENDER PUBLIC WEBSITE & CATALOGUE
      // ==========================================
      let activeCategory = "all";
      let activeSearch = "";

      function renderCatalogue() {
        const grid = document.getElementById("catalogue-grid-container");
        if (!grid) return;

        const products = getProducts();
        const wishlist = getWishlist();

        const filtered = products.filter(item => {
          const matchCat = (activeCategory === "all") || (item.category === activeCategory) || (item.collection === activeCategory);
          const q = activeSearch.toLowerCase().trim();
          const matchSearch = !q || 
            item.name.toLowerCase().includes(q) || 
            item.category.toLowerCase().includes(q) || 
            item.fabric.toLowerCase().includes(q) || 
            item.color.toLowerCase().includes(q) || 
            item.occasion.toLowerCase().includes(q);
          return matchCat && matchSearch;
        });

        if (filtered.length === 0) {
          grid.innerHTML = `
            <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background:#FFF; border-radius:8px; border:1px dashed var(--gold-border);">
              <i class="fa-solid fa-magnifying-glass" style="font-size:2.4rem; color:var(--gold-dark); margin-bottom:12px;"></i>
              <h3 style="font-family:var(--font-serif); color:var(--maroon-deep);">No Designs Found Matching Search</h3>
              <p style="color:var(--text-muted); font-size:0.9rem; margin-top:6px;">Try adjusting your keyword filter or browse all collections.</p>
              <button class="btn btn-sm btn-maroon" style="margin-top:16px;" onclick="App.filterCatalogue('all')">View All Collections</button>
            </div>
          `;
          return;
        }

        grid.innerHTML = filtered.map(item => {
          const inWish = wishlist.includes(item.id);
          const priceDisplay = (item.priceVisibility === "wholesale") 
            ? "Contact for Wholesale Price" 
            : (item.priceVisibility === "fixed" ? item.priceText : "Price on Enquiry");

          return `
            <div class="product-card" id="product-${item.id}">
              <div class="product-img-box" onclick="App.openProductModal(${item.id})">
                <img src="${item.image}" alt="${item.name}" loading="lazy" onerror="this.onerror=null; this.src='assets/images/hero-bridal.jpg';" />
                <div class="product-badges">
                  ${item.wholesale ? '<span class="badge-luxury badge-gold">WHOLESALE</span>' : ''}
                  ${item.retail ? '<span class="badge-luxury">RETAIL</span>' : ''}
                </div>
                <button class="product-wish-btn ${inWish ? 'active' : ''}" title="Save to Wishlist" onclick="event.stopPropagation(); App.toggleWishlist(${item.id})">
                  <i class="fa-${inWish ? 'solid' : 'regular'} fa-heart"></i>
                </button>
              </div>

              <div class="product-content">
                <div class="product-category-row">
                  <span class="product-category">${item.category}</span>
                  <span class="product-sku">${item.sku}</span>
                </div>
                <h3 class="product-name" onclick="App.openProductModal(${item.id})">${item.name}</h3>
                
                <div class="product-meta-specs">
                  <span><strong>Fabric:</strong> ${item.fabric}</span>
                  <span><strong>Work:</strong> ${item.work}</span>
                </div>

                <div class="product-price-box">
                  <span class="price-tag"><i class="fa-solid fa-gem"></i> ${priceDisplay}</span>
                  <span class="delivery-tag"><i class="fa-solid fa-truck"></i> All India</span>
                </div>

                <div class="product-actions">
                  <button class="btn btn-sm btn-outline-gold" onclick="App.openProductModal(${item.id})">
                    <i class="fa-solid fa-eye"></i> Details
                  </button>
                  <button class="btn btn-sm btn-maroon" onclick="App.openEnquiryForProduct(${item.id})">
                    <i class="fa-solid fa-paper-plane"></i> Enquire
                  </button>
                </div>
              </div>
            </div>
          `;
        }).join("");
      }

      function filterCatalogue(category) {
        activeCategory = category;
        const pills = document.querySelectorAll(".filter-pill");
        pills.forEach(p => {
          if (p.textContent.trim().toLowerCase() === category.toLowerCase() || (category === 'all' && p.textContent.includes('All'))) {
            p.classList.add("active");
          } else {
            p.classList.remove("active");
          }
        });
        renderCatalogue();
        const section = document.getElementById("catalogue");
        if (section) section.scrollIntoView({ behavior: "smooth" });
      }

      function handleSearch(val) {
        activeSearch = val;
        renderCatalogue();
      }

      function focusSearch() {
        const input = document.getElementById("catalogue-search-input");
        if (input) {
          input.focus();
          const section = document.getElementById("catalogue");
          if (section) section.scrollIntoView({ behavior: "smooth" });
        }
      }

      // ==========================================
      // PRODUCT DETAIL MODAL & DYNAMIC GALLERY
      // ==========================================
      function openProductModal(id) {
        const product = getProducts().find(p => p.id === id);
        if (!product) return;

        const modal = document.getElementById("product-detail-modal");
        const container = document.getElementById("pdetail-dynamic-content");

        const gallery = product.gallery && product.gallery.length > 0 ? product.gallery : [product.image];
        const settings = getSettings();

        const priceDisplay = (product.priceVisibility === "wholesale") 
          ? "Contact for Wholesale Price" 
          : (product.priceVisibility === "fixed" ? product.priceText : "Price on Enquiry");

        // Dynamic WhatsApp message construction
        const waText = encodeURIComponent(
          `Hello Payal Manufacturing Hub,\n` +
          `I am interested in:\n` +
          `Product: ${product.name}\n` +
          `Product ID: ${product.sku}\n` +
          `Fabric: ${product.fabric}\n` +
          `Requirement: Wholesale / Retail\n` +
          `Please share availability and pricing.`
        );
        const waLink = `https://wa.me/${settings.whatsapp.replace(/[^0-9]/g, '')}?text=${waText}`;

        container.innerHTML = `
          <div>
            <div class="pdetail-gallery-main">
              <img id="pdetail-active-img" src="${gallery[0]}" alt="${product.name}" onerror="this.onerror=null; this.src='assets/images/hero-bridal.jpg';" />
            </div>
            <div class="pdetail-thumbs">
              ${gallery.map((img, i) => `
                <img src="${img}" class="pdetail-thumb ${i === 0 ? 'active' : ''}" onclick="App.switchDetailThumb('${img}', this)" alt="Thumbnail ${i+1}" onerror="this.onerror=null; this.src='assets/images/hero-bridal.jpg';" />
              `).join("")}
            </div>
          </div>

          <div class="pdetail-info">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
              <span class="badge-luxury badge-gold">${product.category}</span>
              <span class="badge-luxury" style="color:var(--gold-dark);">${product.availability}</span>
            </div>

            <h2>${product.name}</h2>

            <div class="pdetail-sku-row">
              <span><strong>Design Code:</strong> ${product.sku}</span>
              <span><strong>Category:</strong> ${product.collection || product.category}</span>
            </div>

            <div class="product-price-box" style="padding:10px 14px;">
              <span class="price-tag" style="font-size:0.95rem;"><i class="fa-solid fa-gem"></i> ${priceDisplay}</span>
              <span class="delivery-tag"><i class="fa-solid fa-truck-fast"></i> Safe Packaging • All India Delivery</span>
            </div>

            <p style="font-size:0.86rem; color:var(--text-muted); line-height:1.6; margin-bottom:14px;">
              ${product.description}
            </p>

            <table class="pdetail-specs-table">
              <tr>
                <td>Fabric</td>
                <td><strong>${product.fabric}</strong></td>
              </tr>
              <tr>
                <td>Embroidery / Work</td>
                <td>${product.work}</td>
              </tr>
              <tr>
                <td>Colorway</td>
                <td>${product.color}</td>
              </tr>
              <tr>
                <td>Occasion</td>
                <td>${product.occasion}</td>
              </tr>
              <tr>
                <td>Sizes / Stitched</td>
                <td>${product.sizes}</td>
              </tr>
              <tr>
                <td>Availability</td>
                <td>${product.wholesale ? 'Wholesale Available' : ''} ${product.retail ? '• Retail Available' : ''}</td>
              </tr>
            </table>

            <div class="pdetail-callout">
              <i class="fa-solid fa-circle-info" style="color:var(--maroon-royal); margin-right:6px;"></i>
              Interested in this design? Contact our team for availability, wholesale pricing and order details.
            </div>

            <div class="pdetail-actions">
              <a href="${waLink}" target="_blank" class="btn btn-whatsapp">
                <i class="fa-brands fa-whatsapp"></i> ENQUIRE ON WHATSAPP
              </a>

              <div class="pdetail-actions-row">
                <a href="tel:${settings.phone.replace(/\s+/g, '')}" class="btn btn-outline-gold">
                  <i class="fa-solid fa-phone"></i> CALL NOW
                </a>
                <button class="btn btn-maroon" onclick="App.openEnquiryForProduct(${product.id})">
                  <i class="fa-solid fa-paper-plane"></i> SEND ENQUIRY
                </button>
              </div>

              <a href="mailto:${settings.email}?subject=Product Enquiry: ${encodeURIComponent(product.name)} (${product.sku})" class="btn btn-sm btn-outline-gold" style="font-size:0.75rem;">
                <i class="fa-solid fa-envelope"></i> EMAIL ENQUIRY
              </a>
            </div>
          </div>
        `;

        modal.classList.add("show");
      }

      function switchDetailThumb(src, el) {
        const main = document.getElementById("pdetail-active-img");
        if (main) main.src = src;
        document.querySelectorAll(".pdetail-thumb").forEach(t => t.classList.remove("active"));
        if (el) el.classList.add("active");
      }

      // ==========================================
      // PRODUCT & GENERAL ENQUIRY SYSTEM
      // ==========================================
      function openEnquiryForProduct(id) {
        closeModals();
        const product = getProducts().find(p => p.id === id);
        const modal = document.getElementById("enquiry-modal");
        
        document.getElementById("enq-product-id").value = product ? product.sku : "GENERAL";
        document.getElementById("enq-product-name").value = product ? product.name : "General Enquiry";
        document.getElementById("enquiry-modal-title").innerText = product ? `Enquire About: ${product.name}` : "Product Enquiry";
        document.getElementById("enquiry-modal-subtitle").innerText = product 
          ? `Design Code: ${product.sku} • Fabric: ${product.fabric}` 
          : "Contact Payal Manufacturing Hub regarding catalog, rates, or custom designs.";

        // Pre-fill user profile if logged in
        const user = getCurrentUser();
        if (user) {
          document.getElementById("enq-name").value = user.name || "";
          document.getElementById("enq-phone").value = user.phone || "";
          document.getElementById("enq-email").value = user.email || "";
          document.getElementById("enq-city").value = user.city || "";
        }

        modal.classList.add("show");
      }

      function openGeneralEnquiryModal() {
        openEnquiryForProduct(null);
      }

      function handleProductEnquirySubmit(e) {
        e.preventDefault();
        const form = e.target;
        const productId = form.productId.value;
        const productName = form.productName.value;
        const customerName = form.customerName.value.trim();
        const mobileNumber = form.mobileNumber.value.trim();
        const emailAddress = form.emailAddress.value.trim();
        const city = form.city.value.trim();
        const requirementType = form.requirementType.value;
        const quantity = form.quantity.value.trim();
        const message = form.message.value.trim();

        const enquiries = getEnquiries();
        const newEnquiry = {
          id: "ENQ-" + Math.floor(100000 + Math.random() * 900000),
          date: new Date().toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }),
          productId: productId,
          productName: productName,
          customerName: customerName,
          mobileNumber: mobileNumber,
          emailAddress: emailAddress,
          city: city,
          requirementType: requirementType,
          quantity: quantity,
          message: message,
          status: "New"
        };

        enquiries.unshift(newEnquiry);
        setEnquiries(enquiries);

        // Transactional notification emails
        const settings = getSettings();
        // A. To Admin
        logSimulatedEmail(
          "Product Enquiry",
          settings.email,
          `New Product Enquiry — ${productName} from ${customerName}`,
          `Customer: ${customerName}\nPhone: ${mobileNumber}\nEmail: ${emailAddress}\nCity: ${city}\nProduct: ${productName} (${productId})\nType: ${requirementType}\nQuantity: ${quantity}\nMessage: ${message}`
        );

        // B. Confirmation to Customer (if email provided)
        if (emailAddress) {
          logSimulatedEmail(
            "Customer Confirmation",
            emailAddress,
            `Enquiry Confirmation — Payal Manufacturing Hub`,
            `Namaste ${customerName},\nThank you for enquiring about "${productName}". Our team at Bhuleshwar, Mumbai has received your details.\nRequirement: ${requirementType} (${quantity}).\nWe will reach out to you shortly via Phone/WhatsApp.`
          );
        }

        showToast("Enquiry submitted successfully! Our team will contact you shortly.");
        closeModals();

        // Optional: auto-open WhatsApp with pre-filled enquiry format
        setTimeout(() => {
          const waText = encodeURIComponent(
            `Hello Payal Manufacturing Hub,\n` +
            `I have submitted an enquiry:\n` +
            `Customer: ${customerName}\n` +
            `Product: ${productName} (ID: ${productId})\n` +
            `Requirement: ${requirementType}\n` +
            `Quantity: ${quantity}\n` +
            `City: ${city}\n` +
            `Message: ${message}`
          );
          if (confirm("Would you also like to open WhatsApp to connect directly with the manufacturer now?")) {
            window.open(`https://wa.me/${settings.whatsapp.replace(/[^0-9]/g, '')}?text=${waText}`, "_blank");
          }
        }, 600);
      }

      function triggerInstantWhatsAppEnquiry() {
        const form = document.getElementById("product-enquiry-form");
        const productName = form.productName.value || "Payal Manufacturing Hub Ethnic Wear";
        const productId = form.productId.value || "PMH-CAT";
        const customerName = form.customerName.value || "Customer";
        const requirementType = form.requirementType.value || "Wholesale/Retail";
        const quantity = form.quantity.value || "1 Piece";
        const message = form.message.value || "Looking for pricing and delivery details.";
        const settings = getSettings();

        const waText = encodeURIComponent(
          `Hello Payal Manufacturing Hub,\n` +
          `I am interested in:\n` +
          `Product: ${productName}\n` +
          `Product ID: ${productId}\n` +
          `Customer Name: ${customerName}\n` +
          `Requirement: ${requirementType}\n` +
          `Quantity: ${quantity}\n` +
          `Message: ${message}\n` +
          `Please share availability and pricing.`
        );
        window.open(`https://wa.me/${settings.whatsapp.replace(/[^0-9]/g, '')}?text=${waText}`, "_blank");
      }

      // ==========================================
      // WHOLESALE ENQUIRY HANDLER
      // ==========================================
      function handleWholesaleSubmit(e) {
        e.preventDefault();
        const form = e.target;
        const lead = {
          id: "WHL-" + Math.floor(10000 + Math.random() * 90000),
          date: new Date().toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }),
          customerName: form.customerName.value.trim(),
          businessName: form.businessName.value.trim(),
          mobileNumber: form.mobileNumber.value.trim(),
          emailAddress: form.emailAddress.value.trim(),
          city: form.city.value.trim(),
          state: form.state.value.trim(),
          productCategory: form.productCategory.value,
          approxQuantity: form.approxQuantity.value,
          message: form.message.value.trim(),
          status: "New"
        };

        const leads = getWholesaleLeads();
        leads.unshift(lead);
        setWholesaleLeads(leads);

        // Transactional Email notification to Admin
        const settings = getSettings();
        logSimulatedEmail(
          "Wholesale Lead",
          settings.email,
          `New Wholesale Lead — ${lead.businessName} (${lead.customerName})`,
          `Business Name: ${lead.businessName}\nContact Person: ${lead.customerName}\nMobile: ${lead.mobileNumber}\nEmail: ${lead.emailAddress}\nLocation: ${lead.city}, ${lead.state}\nCategory: ${lead.productCategory}\nEst Qty: ${lead.approxQuantity}\nRequirements: ${lead.message}`
        );

        if (lead.emailAddress) {
          logSimulatedEmail(
            "Wholesale Confirmation",
            lead.emailAddress,
            `Wholesale Partnership Acknowledgement — Payal Manufacturing Hub`,
            `Dear ${lead.customerName},\nThank you for reaching out to Payal Manufacturing Hub. We have registered your wholesale application for ${lead.businessName}.\nOur B2B merchandising desk will contact you via WhatsApp/Phone with volume pricing sheets.`
          );
        }

        form.reset();
        showToast("Wholesale inquiry sent! Our B2B coordinator will contact you shortly.");

        setTimeout(() => {
          if (confirm("Would you like to open WhatsApp to chat with our wholesale director immediately?")) {
            const waText = encodeURIComponent(
              `Hello Payal Manufacturing Hub,\n` +
              `I have registered a Wholesale Inquiry for:\n` +
              `Business Name: ${lead.businessName}\n` +
              `Contact Person: ${lead.customerName}\n` +
              `City: ${lead.city}, ${lead.state}\n` +
              `Category: ${lead.productCategory}\n` +
              `Quantity: ${lead.approxQuantity}`
            );
            window.open(`https://wa.me/${settings.whatsapp.replace(/[^0-9]/g, '')}?text=${waText}`, "_blank");
          }
        }, 500);
      }

      // ==========================================
      // CONTACT US FORM HANDLER
      // ==========================================
      function handleContactSubmit(e) {
        e.preventDefault();
        const form = e.target;
        const msg = {
          name: form.senderName.value.trim(),
          phone: form.senderPhone.value.trim(),
          email: form.senderEmail.value.trim(),
          subject: form.subject.value.trim(),
          message: form.message.value.trim(),
          date: new Date().toLocaleDateString("en-IN")
        };

        const settings = getSettings();
        logSimulatedEmail(
          "Contact Message",
          settings.email,
          `New Contact Inquiry from ${msg.name}: ${msg.subject || 'Showroom Inquiry'}`,
          `Name: ${msg.name}\nPhone: ${msg.phone}\nEmail: ${msg.email}\nSubject: ${msg.subject}\nMessage: ${msg.message}`
        );

        form.reset();
        showToast("Your message has been sent to our showroom desk.");
      }

      // ==========================================
      // WISHLIST FUNCTIONALITY
      // ==========================================
      function toggleWishlist(productId) {
        let list = getWishlist();
        if (list.includes(productId)) {
          list = list.filter(id => id !== productId);
          showToast("Item removed from Wishlist", "fa-heart-crack");
        } else {
          list.push(productId);
          showToast("Item added to your Wishlist!", "fa-heart");
        }
        setWishlist(list);
        updateWishlistCount();
        renderCatalogue();
        renderCustomerWishlist();
      }

      function updateWishlistCount() {
        const countBadge = document.getElementById("nav-wishlist-count");
        if (countBadge) {
          const count = getWishlist().length;
          countBadge.innerText = count;
        }
      }

      function openWishlistModal() {
        const user = getCurrentUser();
        if (!user) {
          openCustomerAuthModal('login');
          showToast("Please sign in to view and save your wishlist", "fa-user-lock");
          return;
        }
        navigateTo('customer-dashboard');
        switchCustTab('wishlist');
      }

      // ==========================================
      // CUSTOMER AUTH & DASHBOARD
      // ==========================================
      function handleAccountClick() {
        const user = getCurrentUser();
        if (user) {
          navigateTo('customer-dashboard');
        } else {
          openCustomerAuthModal('login');
        }
      }

      function openCustomerAuthModal(mode = 'login') {
        closeModals();
        toggleAuthView(mode);
        document.getElementById("customer-auth-modal").classList.add("show");
      }

      function toggleAuthView(mode) {
        const loginBox = document.getElementById("auth-login-box");
        const regBox = document.getElementById("auth-register-box");
        const title = document.getElementById("auth-title");
        const sub = document.getElementById("auth-subtitle");

        if (mode === 'register') {
          loginBox.style.display = "none";
          regBox.style.display = "block";
          title.innerText = "Register Customer Account";
          sub.innerText = "Join Payal Manufacturing Hub for wholesale pricing & catalogue tracking";
        } else {
          loginBox.style.display = "block";
          regBox.style.display = "none";
          title.innerText = "Customer Sign In";
          sub.innerText = "Access your saved wishlist & previous enquiries";
        }
      }

      function handleCustomerRegister(e) {
        e.preventDefault();
        const name = document.getElementById("reg-name").value.trim();
        const mobile = document.getElementById("reg-mobile").value.trim();
        const email = document.getElementById("reg-email").value.trim();
        const type = document.getElementById("reg-type").value;
        const pass = document.getElementById("reg-password").value;

        const customers = getCustomers();
        const existing = customers.find(c => c.phone === mobile || (email && c.email === email));
        if (existing) {
          showToast("Account already exists with this mobile or email!", "fa-triangle-exclamation");
          return;
        }

        const newCustomer = {
          id: Date.now(),
          name: name,
          phone: mobile,
          email: email || `${mobile}@payalcustomer.com`,
          type: type,
          city: "Mumbai",
          date: new Date().toLocaleDateString("en-IN")
        };

        customers.push(newCustomer);
        setCustomers(customers);
        setCurrentUser(newCustomer);

        // Transactional notification email to admin
        const settings = getSettings();
        logSimulatedEmail(
          "Customer Registration",
          settings.email,
          `New Customer Registration — ${name} (${type})`,
          `Customer Name: ${name}\nMobile: ${mobile}\nEmail: ${email}\nType: ${type}\nRegistration Date: ${new Date().toLocaleString()}`
        );

        closeModals();
        showToast(`Welcome to Payal Hub, ${name}!`);
        navigateTo('customer-dashboard');
      }

      function handleCustomerLogin(e) {
        e.preventDefault();
        const identifier = document.getElementById("login-identifier").value.trim();
        const customers = getCustomers();
        let user = customers.find(c => c.phone === identifier || c.email === identifier);

        // Fallback demo user creation if testing fresh credentials
        if (!user) {
          user = {
            id: Date.now(),
            name: identifier.includes("@") ? identifier.split("@")[0] : `Customer (${identifier})`,
            phone: identifier.includes("@") ? "+91 9820011223" : identifier,
            email: identifier.includes("@") ? identifier : `${identifier}@customer.com`,
            type: "Retail / Wholesale",
            city: "Mumbai",
            date: new Date().toLocaleDateString("en-IN")
          };
          customers.push(user);
          setCustomers(customers);
        }

        setCurrentUser(user);

        // Transactional Login alert to Admin
        const settings = getSettings();
        logSimulatedEmail(
          "Customer Login",
          settings.email,
          `New Customer Login — Payal Manufacturing Hub`,
          `Customer: ${user.name}\nEmail: ${user.email}\nMobile: ${user.phone}\nLogin Time: ${new Date().toLocaleString()}`
        );

        closeModals();
        showToast(`Namaste, ${user.name}!`);
        navigateTo('customer-dashboard');
      }

      function customerLogout() {
        localStorage.removeItem(STORAGE_KEYS.CURRENT_USER);
        showToast("Signed out successfully.");
        navigateTo('home');
      }

      function renderCustomerDashboard() {
        const user = getCurrentUser();
        if (!user) {
          navigateTo('home');
          return;
        }

        document.getElementById("cust-welcome-title").innerText = `Namaste, ${user.name}`;
        document.getElementById("cust-sub-details").innerText = `Customer Type: ${user.type || 'Retail'} • Phone: ${user.phone}`;

        // Populate Profile inputs
        document.getElementById("cust-prof-name").value = user.name || "";
        document.getElementById("cust-prof-phone").value = user.phone || "";
        document.getElementById("cust-prof-email").value = user.email || "";
        document.getElementById("cust-prof-city").value = user.city || "";
        document.getElementById("cust-prof-business").value = user.businessName || "";

        // Enquiries Table
        const userEnquiries = getEnquiries().filter(e => e.mobileNumber === user.phone || e.emailAddress === user.email);
        const tbody = document.getElementById("cust-enquiries-table-body");
        if (userEnquiries.length === 0) {
          tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:30px; color:var(--text-muted);">No enquiries submitted yet. Browse our catalogue to enquire about any design.</td></tr>`;
        } else {
          tbody.innerHTML = userEnquiries.map(enq => `
            <tr>
              <td><strong>${enq.id}</strong></td>
              <td>${enq.productName}</td>
              <td>${enq.date}</td>
              <td>${enq.quantity}</td>
              <td><span class="badge-luxury">${enq.requirementType}</span></td>
              <td><span class="status-badge status-${enq.status.toLowerCase()}">${enq.status}</span></td>
              <td>
                <a href="https://wa.me/918209206788?text=Hello,%20checking%20status%20for%20enquiry%20${enq.id}" target="_blank" class="btn btn-sm btn-whatsapp">
                  <i class="fa-brands fa-whatsapp"></i> Track
                </a>
              </td>
            </tr>
          `).join("");
        }

        renderCustomerWishlist();
      }

      function renderCustomerWishlist() {
        const wishContainer = document.getElementById("cust-wishlist-grid");
        if (!wishContainer) return;
        const wishIds = getWishlist();
        const products = getProducts().filter(p => wishIds.includes(p.id));

        if (products.length === 0) {
          wishContainer.innerHTML = `<p style="grid-column:1/-1; text-align:center; padding:30px; color:var(--text-muted);">Your wishlist is empty. Tap the heart icon on any design in the catalogue to save it here.</p>`;
          return;
        }

        wishContainer.innerHTML = products.map(item => `
          <div class="product-card">
            <div class="product-img-box" onclick="App.openProductModal(${item.id})">
              <img src="${item.image}" alt="${item.name}" onerror="this.onerror=null; this.src='assets/images/hero-bridal.jpg';" />
            </div>
            <div class="product-content">
              <span class="product-category">${item.category}</span>
              <h4 class="product-name" onclick="App.openProductModal(${item.id})">${item.name}</h4>
              <div class="product-actions" style="margin-top:10px;">
                <button class="btn btn-sm btn-maroon" onclick="App.openEnquiryForProduct(${item.id})">Enquire</button>
                <button class="btn btn-sm btn-outline-gold" onclick="App.toggleWishlist(${item.id})">Remove</button>
              </div>
            </div>
          </div>
        `).join("");
      }

      function switchCustTab(tab) {
        document.querySelectorAll(".dashboard-nav-tabs .dash-tab-btn").forEach(b => b.classList.remove("active"));
        event.currentTarget.classList.add("active");

        document.getElementById("cust-tab-enquiries").style.display = tab === 'enquiries' ? 'block' : 'none';
        document.getElementById("cust-tab-wishlist").style.display = tab === 'wishlist' ? 'block' : 'none';
        document.getElementById("cust-tab-profile").style.display = tab === 'profile' ? 'block' : 'none';
      }

      function saveCustomerProfile(e) {
        e.preventDefault();
        const user = getCurrentUser();
        if (!user) return;

        user.name = document.getElementById("cust-prof-name").value.trim();
        user.phone = document.getElementById("cust-prof-phone").value.trim();
        user.email = document.getElementById("cust-prof-email").value.trim();
        user.city = document.getElementById("cust-prof-city").value.trim();
        user.businessName = document.getElementById("cust-prof-business").value.trim();

        setCurrentUser(user);

        // Update in customers table
        const customers = getCustomers();
        const idx = customers.findIndex(c => c.id === user.id);
        if (idx !== -1) {
          customers[idx] = user;
          setCustomers(customers);
        }

        showToast("Profile details updated successfully!");
        renderCustomerDashboard();
      }

      // ==========================================
      // SECURE ADMIN AUTH (SHOP OWNER ONLY)
      // ==========================================
      let failedAdminAttempts = 0;
      let adminLockoutUntil = 0;

      function toggleAdminPasswordVisibility() {
        const passInput = document.getElementById("admin-pass-input");
        const icon = document.getElementById("admin-pass-toggle-icon");
        if (!passInput) return;
        if (passInput.type === "password") {
          passInput.type = "text";
          if (icon) {
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
          }
        } else {
          passInput.type = "password";
          if (icon) {
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
          }
        }
      }

      function openAdminLoginModal() {
        if (isAdminLoggedIn()) {
          navigateTo('admin-dashboard');
        } else {
          closeModals();
          // Always reset inputs to blank for privacy & security
          const u = document.getElementById("admin-user-input");
          const p = document.getElementById("admin-pass-input");
          if (u) u.value = "";
          if (p) {
            p.value = "";
            p.type = "password";
          }
          const icon = document.getElementById("admin-pass-toggle-icon");
          if (icon) {
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
          }
          document.getElementById("admin-login-modal").classList.add("show");
          if (u) setTimeout(() => u.focus(), 150);
        }
      }

      function handleAdminLogin(e) {
        e.preventDefault();

        // Rate-limiting / Brute-force protection
        const now = Date.now();
        if (adminLockoutUntil > now) {
          const remaining = Math.ceil((adminLockoutUntil - now) / 1000);
          showToast(`Access locked! Please wait ${remaining} seconds.`, "fa-shield-halved");
          return;
        }

        const u = document.getElementById("admin-user-input").value.trim().toLowerCase();
        const p = document.getElementById("admin-pass-input").value.trim();

        // Strictly verify shop owner credentials (Username: payal, Password: payal@2026)
        if (u === "payal" && p === "payal@2026") {
          failedAdminAttempts = 0;
          setAdminLoggedIn(true);
          closeModals();
          document.getElementById("admin-user-input").value = "";
          document.getElementById("admin-pass-input").value = "";
          showToast("Shop Owner Authenticated! Welcome to Admin Console.", "fa-circle-check");
          navigateTo('admin-dashboard');
        } else {
          failedAdminAttempts++;
          if (failedAdminAttempts >= 5) {
            adminLockoutUntil = Date.now() + 30000; // 30 sec security lock
            showToast("Too many incorrect attempts! Security locked for 30 seconds.", "fa-triangle-exclamation");
          } else {
            // High-security message: never leaks credentials or field specifics
            showToast("Access Denied: Incorrect username or password!", "fa-shield-halved");
          }
        }
      }

      function adminLogout() {
        setAdminLoggedIn(false);
        showToast("Admin session ended.");
        navigateTo('home');
      }

      function switchAdminTab(tab) {
        document.querySelectorAll("#admin-dashboard-view .dash-tab-btn").forEach(b => b.classList.remove("active"));
        if (event && event.currentTarget) event.currentTarget.classList.add("active");

        const tabs = ['overview', 'products', 'enquiries', 'wholesale', 'customers', 'emails', 'settings'];
        tabs.forEach(t => {
          const el = document.getElementById(`admin-tab-${t}`);
          if (el) el.style.display = (t === tab) ? 'block' : 'none';
        });

        if (tab === 'overview') renderAdminOverview();
        if (tab === 'products') renderAdminProductsTable();
        if (tab === 'enquiries') renderAdminEnquiriesTable();
        if (tab === 'wholesale') renderAdminWholesaleTable();
        if (tab === 'customers') renderAdminCustomersTable();
        if (tab === 'emails') renderAdminEmailLogsTable();
        if (tab === 'settings') populateAdminSettingsForm();
      }

      function renderAdminDashboard() {
        if (!isAdminLoggedIn()) {
          openAdminLoginModal();
          return;
        }
        renderAdminOverview();
        renderAdminProductsTable();
        renderAdminEnquiriesTable();
        renderAdminWholesaleTable();
        renderAdminCustomersTable();
        renderAdminEmailLogsTable();
        populateAdminSettingsForm();
      }

      function renderAdminOverview() {
        const products = getProducts();
        const enquiries = getEnquiries();
        const wholesale = getWholesaleLeads();
        const customers = getCustomers();

        document.getElementById("stat-total-products").innerText = products.length;
        document.getElementById("stat-total-enquiries").innerText = enquiries.length;
        document.getElementById("stat-wholesale-leads").innerText = wholesale.length;
        document.getElementById("stat-total-customers").innerText = customers.length;

        // Recent enquiries preview
        const recentBody = document.getElementById("admin-recent-enquiries-body");
        if (recentBody) {
          const slice = enquiries.slice(0, 5);
          if (slice.length === 0) {
            recentBody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:20px; color:var(--text-muted);">No enquiries yet.</td></tr>`;
          } else {
            recentBody.innerHTML = slice.map(enq => `
              <tr>
                <td><strong>${enq.id}</strong></td>
                <td>${enq.customerName}</td>
                <td>${enq.mobileNumber}</td>
                <td>${enq.productName}</td>
                <td><span class="badge-luxury">${enq.requirementType}</span></td>
                <td><span class="status-badge status-${enq.status.toLowerCase()}">${enq.status}</span></td>
              </tr>
            `).join("");
          }
        }
      }

      function renderAdminProductsTable() {
        const tbody = document.getElementById("admin-products-table-body");
        if (!tbody) return;
        const products = getProducts();

        tbody.innerHTML = products.map(item => `
          <tr>
            <td><img src="${item.image}" style="width:48px; height:60px; object-fit:cover; border-radius:4px;" alt="Product Thumb" onerror="this.onerror=null; this.src='assets/images/hero-bridal.jpg';" /></td>
            <td>
              <strong>${item.name}</strong>
              <div style="font-size:0.75rem; color:var(--text-muted);">${item.sku}</div>
            </td>
            <td>${item.category}</td>
            <td>${item.fabric} / ${item.color}</td>
            <td>${item.wholesale ? '<i class="fa-solid fa-check" style="color:green;"></i>' : '<i class="fa-solid fa-xmark"></i>'}</td>
            <td>${item.retail ? '<i class="fa-solid fa-check" style="color:green;"></i>' : '<i class="fa-solid fa-xmark"></i>'}</td>
            <td>
              <select onchange="App.changeProductStatus(${item.id}, this.value)" style="padding:4px 8px; font-size:0.78rem; border-radius:4px; border:1px solid var(--gold-border);">
                <option value="Available" ${item.availability === 'Available' ? 'selected' : ''}>Available</option>
                <option value="Out of Stock" ${item.availability === 'Out of Stock' ? 'selected' : ''}>Out of Stock</option>
              </select>
            </td>
            <td>${item.priceVisibility === 'wholesale' ? 'Wholesale Only' : (item.priceVisibility === 'fixed' ? 'Fixed Price' : 'Price on Enquiry')}</td>
            <td>
              <div style="display:flex; gap:6px;">
                <button class="btn btn-sm btn-outline-gold" style="padding:4px 8px;" title="Edit" onclick="App.openEditProductModal(${item.id})"><i class="fa-solid fa-pen-to-square"></i></button>
                <button class="btn btn-sm btn-outline-gold" style="padding:4px 8px;" title="Duplicate" onclick="App.duplicateProduct(${item.id})"><i class="fa-solid fa-copy"></i></button>
                <button class="btn btn-sm btn-maroon" style="padding:4px 8px;" title="Delete" onclick="App.deleteProduct(${item.id})"><i class="fa-solid fa-trash"></i></button>
              </div>
            </td>
          </tr>
        `).join("");
