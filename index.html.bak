            <button class="btn btn-sm btn-outline-gold" style="color:#FFF; border-color:#FFF;" onclick="App.navigateTo('home')"><i class="fa-solid fa-shop"></i> Back to Store</button>
            <button class="btn btn-sm btn-maroon" onclick="App.customerLogout()"><i class="fa-solid fa-right-from-bracket"></i> Sign Out</button>
          </div>
        </div>

        <div class="dashboard-nav-tabs">
          <button class="dash-tab-btn active" onclick="App.switchCustTab('enquiries')"><i class="fa-solid fa-list-check"></i> My Enquiries</button>
          <button class="dash-tab-btn" onclick="App.switchCustTab('wishlist')"><i class="fa-solid fa-heart"></i> My Wishlist</button>
          <button class="dash-tab-btn" onclick="App.switchCustTab('profile')"><i class="fa-solid fa-user-pen"></i> My Profile</button>
        </div>

        <div class="dashboard-content-body">
          <!-- Tab 1: Enquiries -->
          <div id="cust-tab-enquiries">
            <h3 style="font-family:var(--font-serif); margin-bottom:16px; color:var(--maroon-deep);">My Product & Wholesale Enquiries</h3>
            <div class="admin-table-wrap">
              <table class="luxury-table">
                <thead>
                  <tr>
                    <th>Enquiry ID</th>
                    <th>Product / Title</th>
                    <th>Date</th>
                    <th>Qty</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody id="cust-enquiries-table-body">
                  <!-- Populated by JS -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Tab 2: Wishlist -->
          <div id="cust-tab-wishlist" style="display:none;">
            <h3 style="font-family:var(--font-serif); margin-bottom:16px; color:var(--maroon-deep);">Saved Wishlist Items</h3>
            <div class="catalogue-grid" id="cust-wishlist-grid"></div>
          </div>

          <!-- Tab 3: Profile -->
          <div id="cust-tab-profile" style="display:none;">
            <h3 style="font-family:var(--font-serif); margin-bottom:16px; color:var(--maroon-deep);">My Profile Information</h3>
            <form id="cust-profile-form" onsubmit="App.saveCustomerProfile(event)" style="max-width:600px;">
              <div class="form-row">
                <div class="form-group">
                  <label>Full Name</label>
                  <input type="text" class="form-control" id="cust-prof-name" required />
                </div>
                <div class="form-group">
                  <label>Mobile Number</label>
                  <input type="tel" class="form-control" id="cust-prof-phone" required />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label>Email Address</label>
                  <input type="email" class="form-control" id="cust-prof-email" required />
                </div>
                <div class="form-group">
                  <label>City</label>
                  <input type="text" class="form-control" id="cust-prof-city" />
                </div>
              </div>
              <div class="form-group">
                <label>Business / Boutique Name (If applicable)</label>
                <input type="text" class="form-control" id="cust-prof-business" />
              </div>
              <button type="submit" class="btn btn-maroon"><i class="fa-solid fa-floppy-disk"></i> Update Profile</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       ADMIN SECURE DASHBOARD VIEW (SPA VIEW)
       ========================================================================== -->
  <section class="dashboard-panel-view" id="admin-dashboard-view">
    <div class="container">
      <div class="dashboard-card-wrap">
        <div class="dashboard-header" style="background:#1B0307;">
          <div>
            <span class="badge-luxury badge-gold">SECURE MANAGEMENT CONSOLE</span>
            <h2>Payal Manufacturing Hub — Admin</h2>
            <p style="font-size:0.8rem; color:#E8DCB8; margin-top:4px;">Manage Products, Enquiries, Wholesale Leads, and Live Settings</p>
          </div>
          <div style="display:flex; gap:10px;">
            <button class="btn btn-sm btn-outline-gold" style="color:#FFF; border-color:#FFF;" onclick="App.navigateTo('home')"><i class="fa-solid fa-eye"></i> View Live Site</button>
            <button class="btn btn-sm btn-maroon" onclick="App.adminLogout()"><i class="fa-solid fa-lock"></i> Sign Out Admin</button>
          </div>
        </div>

        <div class="dashboard-nav-tabs">
          <button class="dash-tab-btn active" onclick="App.switchAdminTab('overview')"><i class="fa-solid fa-chart-line"></i> Overview</button>
          <button class="dash-tab-btn" onclick="App.switchAdminTab('products')"><i class="fa-solid fa-shirt"></i> Products Manager</button>
          <button class="dash-tab-btn" onclick="App.switchAdminTab('enquiries')"><i class="fa-solid fa-inbox"></i> Product Enquiries</button>
          <button class="dash-tab-btn" onclick="App.switchAdminTab('wholesale')"><i class="fa-solid fa-handshake"></i> Wholesale Leads</button>
          <button class="dash-tab-btn" onclick="App.switchAdminTab('customers')"><i class="fa-solid fa-users"></i> Registered Customers</button>
          <button class="dash-tab-btn" onclick="App.switchAdminTab('emails')"><i class="fa-solid fa-envelope"></i> Email Notification Logs</button>
          <button class="dash-tab-btn" onclick="App.switchAdminTab('settings')"><i class="fa-solid fa-gear"></i> Website Settings</button>
        </div>

        <div class="dashboard-content-body">
          <!-- 1. OVERVIEW TAB -->
          <div id="admin-tab-overview">
            <div class="stat-cards-grid">
              <div class="stat-card">
                <div class="stat-icon"><i class="fa-solid fa-shirt"></i></div>
                <div class="stat-info">
                  <h3 id="stat-total-products">0</h3>
                  <p>Total Products</p>
                </div>
              </div>
              <div class="stat-card">
                <div class="stat-icon" style="background:#25D366;"><i class="fa-solid fa-comments"></i></div>
                <div class="stat-info">
                  <h3 id="stat-total-enquiries">0</h3>
                  <p>Product Enquiries</p>
                </div>
              </div>
              <div class="stat-card">
                <div class="stat-icon" style="background:#B38728;"><i class="fa-solid fa-briefcase"></i></div>
                <div class="stat-info">
                  <h3 id="stat-wholesale-leads">0</h3>
                  <p>Wholesale Leads</p>
                </div>
              </div>
              <div class="stat-card">
                <div class="stat-icon" style="background:#1E40AF;"><i class="fa-solid fa-users"></i></div>
                <div class="stat-info">
                  <h3 id="stat-total-customers">0</h3>
                  <p>Active Customers</p>
                </div>
              </div>
            </div>

            <div style="background:var(--bg-cream); border:1px solid var(--gold-border); border-radius:var(--radius-sm); padding:20px; margin-bottom:24px;">
              <h4 style="font-family:var(--font-serif); color:var(--maroon-royal); margin-bottom:8px;">Recent Enquiries Snapshot</h4>
              <div class="admin-table-wrap">
                <table class="luxury-table">
                  <thead>
                    <tr>
                      <th>Enquiry ID</th>
                      <th>Customer</th>
                      <th>Phone</th>
                      <th>Item / Subject</th>
                      <th>Type</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody id="admin-recent-enquiries-body"></tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- 2. PRODUCTS MANAGER TAB -->
          <div id="admin-tab-products" style="display:none;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:12px;">
              <div>
                <h3 style="font-family:var(--font-serif); color:var(--maroon-deep); margin-bottom:4px;">Active Catalogue Products</h3>
                <p style="font-size:0.8rem; color:var(--text-muted); margin:0;">
                  <i class="fa-solid fa-hard-drive" style="color:var(--gold-dark);"></i> Stored in Browser Local Database &bull; Drag &amp; drop photos without external database.
                </p>
              </div>
              <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                <button type="button" class="btn btn-sm btn-outline-gold" onclick="App.exportProductsBackup()" title="Download complete catalogue backup as JSON">
                  <i class="fa-solid fa-cloud-arrow-down"></i> Backup JSON
                </button>
                <label class="btn btn-sm btn-outline-gold" style="cursor:pointer; margin:0;" title="Restore catalogue from JSON backup">
                  <i class="fa-solid fa-cloud-arrow-up"></i> Restore JSON
                  <input type="file" accept=".json" style="display:none;" onchange="App.importProductsBackup(event)" />
                </label>
                <button type="button" class="btn btn-sm btn-maroon" onclick="App.openAddProductModal()">
                  <i class="fa-solid fa-plus"></i> Add New Product
                </button>
              </div>
            </div>

            <div class="admin-table-wrap">
              <table class="luxury-table">
                <thead>
                  <tr>
                    <th>Image</th>
                    <th>Product Title</th>
                    <th>Category</th>
                    <th>Fabric / Color</th>
                    <th>Wholesale</th>
                    <th>Retail</th>
                    <th>Status</th>
                    <th>Price Visibility</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="admin-products-table-body"></tbody>
              </table>
            </div>
          </div>

          <!-- 3. PRODUCT ENQUIRIES TAB -->
          <div id="admin-tab-enquiries" style="display:none;">
            <h3 style="font-family:var(--font-serif); color:var(--maroon-deep); margin-bottom:16px;">Product Enquiries Inquiries</h3>
            <div class="admin-table-wrap">
              <table class="luxury-table">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Customer Name</th>
                    <th>Phone / WhatsApp</th>
                    <th>Email</th>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Quick Contact</th>
                  </tr>
                </thead>
                <tbody id="admin-enquiries-table-body"></tbody>
              </table>
            </div>
          </div>

          <!-- 4. WHOLESALE LEADS TAB -->
          <div id="admin-tab-wholesale" style="display:none;">
            <h3 style="font-family:var(--font-serif); color:var(--maroon-deep); margin-bottom:16px;">Wholesale Partner Applications</h3>
            <div class="admin-table-wrap">
              <table class="luxury-table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Company / Name</th>
                    <th>Mobile</th>
                    <th>Location</th>
                    <th>Category</th>
                    <th>Est. Qty</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="admin-wholesale-table-body"></tbody>
              </table>
            </div>
          </div>

          <!-- 5. REGISTERED CUSTOMERS TAB -->
          <div id="admin-tab-customers" style="display:none;">
            <h3 style="font-family:var(--font-serif); color:var(--maroon-deep); margin-bottom:16px;">Registered Customer Directory</h3>
            <div class="admin-table-wrap">
              <table class="luxury-table">
                <thead>
                  <tr>
                    <th>Customer Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>City</th>
                    <th>Type</th>
                    <th>Registered On</th>
                  </tr>
                </thead>
                <tbody id="admin-customers-table-body"></tbody>
              </table>
            </div>
          </div>

          <!-- 6. EMAIL LOGS TAB (TRANSACTIONAL PREVIEW) -->
          <div id="admin-tab-emails" style="display:none;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
              <div>
                <h3 style="font-family:var(--font-serif); color:var(--maroon-deep);">Transactional Email Dispatch Logs</h3>
                <p style="font-size:0.8rem; color:var(--text-muted);">Simulated SMTP dispatch stream for customer logins, enquiries, and confirmations.</p>
              </div>
              <button class="btn btn-sm btn-outline-gold" onclick="App.clearEmailLogs()"><i class="fa-solid fa-trash-can"></i> Clear Logs</button>
            </div>
            <div class="admin-table-wrap">
              <table class="luxury-table">
                <thead>
                  <tr>
                    <th>Time</th>
                    <th>Recipient</th>
                    <th>Event / Subject</th>
                    <th>Preview Body</th>
                  </tr>
                </thead>
                <tbody id="admin-email-logs-body"></tbody>
              </table>
            </div>
          </div>

          <!-- 7. WEBSITE SETTINGS TAB (LIVE EDITABLE) -->
          <div id="admin-tab-settings" style="display:none;">
            <h3 style="font-family:var(--font-serif); color:var(--maroon-deep); margin-bottom:16px;">Live Website & Identity Settings</h3>
            <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:20px;">Edits saved here immediately update the website headers, hero, contact section and footer.</p>
            <form id="admin-settings-form" onsubmit="App.saveWebsiteSettings(event)" style="max-width:700px;">
              <div class="form-row">
                <div class="form-group">
                  <label>Business Name</label>
                  <input type="text" class="form-control" id="set-business-name" required />
                </div>
                <div class="form-group">
                  <label>Official Tagline</label>
                  <input type="text" class="form-control" id="set-tagline" required />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label>Phone / WhatsApp Number</label>
                  <input type="text" class="form-control" id="set-phone" required />
                </div>
                <div class="form-group">
                  <label>Business Email</label>
                  <input type="email" class="form-control" id="set-email" required />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label>GSTIN</label>
                  <input type="text" class="form-control" id="set-gstin" required />
                </div>
                <div class="form-group">
                  <label>City & State</label>
                  <input type="text" class="form-control" id="set-city-state" value="Mumbai, Maharashtra" />
                </div>
              </div>

              <div class="form-group">
                <label>Showroom Address</label>
                <textarea class="form-control" id="set-address" rows="2" required></textarea>
              </div>

              <div class="form-group">
                <label>Hero Headline</label>
                <input type="text" class="form-control" id="set-hero-headline" required />
              </div>

              <div class="form-group">
                <label>Hero Supporting Description</label>
                <textarea class="form-control" id="set-hero-desc" rows="3" required></textarea>
              </div>

              <button type="submit" class="btn btn-maroon"><i class="fa-solid fa-floppy-disk"></i> Save & Apply Settings</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

