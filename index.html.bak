  <!-- ==========================================================================
       FLOATING WHATSAPP & MOBILE STICKY CALL ACTION BAR
       ========================================================================== -->
  <a href="https://wa.me/918209206788?text=Hello%20Payal%20Manufacturing%20Hub,%20I%20would%20like%20to%20enquire%20about%20your%20ethnic%20wear%20collections." target="_blank" class="floating-whatsapp-btn" title="Chat on WhatsApp">
    <i class="fa-brands fa-whatsapp"></i>
  </a>

  <div class="mobile-sticky-bottom-bar">
    <div class="mobile-bottom-actions">
      <a href="tel:+918209206788" class="btn btn-sm btn-maroon"><i class="fa-solid fa-phone"></i> CALL</a>
      <a href="https://wa.me/918209206788" target="_blank" class="btn btn-sm btn-whatsapp"><i class="fa-brands fa-whatsapp"></i> WHATSAPP</a>
      <button class="btn btn-sm btn-gold" onclick="App.openGeneralEnquiryModal()"><i class="fa-solid fa-paper-plane"></i> ENQUIRE</button>
    </div>
  </div>

  <!-- Toast Notification Wrapper -->
  <div class="toast-container" id="toast-container"></div>

  <!-- ==========================================================================
       MODALS: PRODUCT DETAIL, ENQUIRY, CUSTOMER AUTH, ADMIN AUTH, ADD PRODUCT
       ========================================================================== -->

  <!-- 1. PRODUCT DETAIL MODAL -->
  <div class="modal-backdrop" id="product-detail-modal">
    <div class="modal-dialog">
      <button class="modal-close-btn" onclick="App.closeModals()">&times;</button>
      <div class="product-detail-layout" id="pdetail-dynamic-content">
        <!-- Rendered by JS -->
      </div>
    </div>
  </div>

  <!-- 2. PRODUCT ENQUIRY MODAL -->
  <div class="modal-backdrop" id="enquiry-modal">
    <div class="modal-dialog" style="max-width:620px;">
      <button class="modal-close-btn" onclick="App.closeModals()">&times;</button>
      <div class="enquiry-modal-body">
        <div style="text-align:center; margin-bottom:20px;">
          <span class="badge-luxury badge-gold">DIRECT ENQUIRY</span>
          <h2 style="font-family:var(--font-serif); font-size:1.8rem; color:var(--maroon-deep); margin-top:6px;" id="enquiry-modal-title">Enquire About This Design</h2>
          <p style="font-size:0.84rem; color:var(--text-muted);" id="enquiry-modal-subtitle">Submit your details and get instant availability, price options, and WhatsApp connect.</p>
        </div>

        <form id="product-enquiry-form" onsubmit="App.handleProductEnquirySubmit(event)">
          <input type="hidden" id="enq-product-id" name="productId" value="" />
          <input type="hidden" id="enq-product-name" name="productName" value="" />

          <div class="form-row">
            <div class="form-group">
              <label>Full Name *</label>
              <input type="text" class="form-control" name="customerName" id="enq-name" required placeholder="Your Name" />
            </div>
            <div class="form-group">
              <label>Mobile Number *</label>
              <input type="tel" class="form-control" name="mobileNumber" id="enq-phone" required placeholder="+91 9876543210" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" class="form-control" name="emailAddress" id="enq-email" placeholder="For confirmation email" />
            </div>
            <div class="form-group">
              <label>City / Location *</label>
              <input type="text" class="form-control" name="city" id="enq-city" required placeholder="City name" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Enquiry Type</label>
              <select class="form-control" name="requirementType" id="enq-type">
                <option value="Retail Purchase">Retail (Individual Purchase)</option>
                <option value="Wholesale Bulk">Wholesale (Bulk Production)</option>
              </select>
            </div>
            <div class="form-group">
              <label>Quantity Desired</label>
              <input type="text" class="form-control" name="quantity" id="enq-qty" value="1 Piece" />
            </div>
          </div>

          <div class="form-group">
            <label>Specific Notes / Question</label>
            <textarea class="form-control" name="message" id="enq-msg" rows="3" placeholder="Tell us if you require custom sizing, urgent dispatch, or wholesale fabric swatches..."></textarea>
          </div>

          <button type="submit" class="btn btn-maroon" style="width:100%; margin-bottom:10px;">
            <i class="fa-solid fa-paper-plane"></i> SEND ENQUIRY TO MANUFACTURER
          </button>
          
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
            <button type="button" class="btn btn-whatsapp" onclick="App.triggerInstantWhatsAppEnquiry()">
              <i class="fa-brands fa-whatsapp"></i> WHATSAPP NOW
            </button>
            <a href="tel:+918209206788" class="btn btn-outline-gold">
              <i class="fa-solid fa-phone"></i> CALL NOW
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- 3. CUSTOMER LOGIN & REGISTER MODAL -->
  <div class="modal-backdrop" id="customer-auth-modal">
    <div class="modal-dialog" style="max-width:480px;">
      <button class="modal-close-btn" onclick="App.closeModals()">&times;</button>
      <div class="auth-modal-body">
        <div style="text-align:center; margin-bottom:20px;">
          <svg class="logo-crest-svg" style="width:50px; height:50px; margin:0 auto 10px;" viewBox="0 0 200 200" fill="none">
            <circle cx="100" cy="108" r="54" stroke="#C59B27" stroke-width="3.5" fill="none" />
            <path d="M82 60 L 86 48 L 93 54 L 100 42 L 107 54 L 114 48 L 118 60 Z" fill="#C59B27" />
            <text x="100" y="125" font-family="'Cinzel', serif" font-size="48" font-weight="900" fill="#670014" text-anchor="middle">P</text>
          </svg>
          <h2 style="font-family:var(--font-serif); color:var(--maroon-deep);" id="auth-title">Customer Sign In</h2>
          <p style="font-size:0.82rem; color:var(--text-muted);" id="auth-subtitle">Access your saved wishlist & previous enquiries</p>
        </div>

        <!-- Login Form -->
        <div id="auth-login-box">
          <form onsubmit="App.handleCustomerLogin(event)">
            <div class="form-group">
              <label>Mobile Number or Email *</label>
              <input type="text" class="form-control" id="login-identifier" required placeholder="Phone or email" />
            </div>
            <div class="form-group">
              <label>Password *</label>
              <input type="password" class="form-control" id="login-password" required placeholder="Your password" />
            </div>
            <button type="submit" class="btn btn-maroon" style="width:100%; margin-top:10px;">SIGN IN</button>
          </form>
          <div style="text-align:center; margin-top:18px; font-size:0.84rem;">
            Don't have an account? <a href="javascript:void(0)" style="color:var(--maroon-royal); font-weight:700;" onclick="App.toggleAuthView('register')">Register Here</a>
          </div>
        </div>

        <!-- Register Form -->
        <div id="auth-register-box" style="display:none;">
          <form onsubmit="App.handleCustomerRegister(event)">
            <div class="form-group">
              <label>Full Name *</label>
              <input type="text" class="form-control" id="reg-name" required placeholder="Your name" />
            </div>
            <div class="form-group">
              <label>Mobile Number *</label>
              <input type="tel" class="form-control" id="reg-mobile" required placeholder="+91 9876543210" />
            </div>
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" class="form-control" id="reg-email" placeholder="email@address.com" />
            </div>
            <div class="form-group">
              <label>Account Type</label>
              <select class="form-control" id="reg-type">
                <option value="Retail">Retail Shopper</option>
                <option value="Wholesale">Wholesale / Boutique Owner</option>
              </select>
            </div>
            <div class="form-group">
              <label>Password *</label>
              <input type="password" class="form-control" id="reg-password" required placeholder="Create secure password" />
            </div>
            <button type="submit" class="btn btn-maroon" style="width:100%; margin-top:10px;">CREATE ACCOUNT</button>
          </form>
          <div style="text-align:center; margin-top:18px; font-size:0.84rem;">
            Already have an account? <a href="javascript:void(0)" style="color:var(--maroon-royal); font-weight:700;" onclick="App.toggleAuthView('login')">Sign In</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. ADMIN LOGIN MODAL -->
  <div class="modal-backdrop" id="admin-login-modal">
    <div class="modal-dialog" style="max-width:440px;">
      <button class="modal-close-btn" onclick="App.closeModals()">&times;</button>
      <div class="auth-modal-body">
        <div style="text-align:center; margin-bottom:20px;">
          <i class="fa-solid fa-shield-halved" style="font-size:2.4rem; color:var(--maroon-royal); margin-bottom:8px;"></i>
          <h2 style="font-family:var(--font-serif); color:var(--maroon-deep);">Admin Console Portal</h2>
          <p style="font-size:0.82rem; color:var(--text-muted);">Enter Payal Manufacturing Hub admin credentials.</p>
        </div>

        <form onsubmit="App.handleAdminLogin(event)" autocomplete="off">
          <div class="form-group">
            <label>Admin Username</label>
            <div style="position:relative;">
              <input type="text" class="form-control" id="admin-user-input" required value="" placeholder="Enter Username" autocomplete="off" />
              <i class="fa-solid fa-user-shield" style="position:absolute; right:14px; top:50%; transform:translateY(-50%); color:var(--text-muted); font-size:0.9rem;"></i>
            </div>
          </div>
          <div class="form-group">
            <label>Security Key / Password</label>
            <div style="position:relative;">
              <input type="password" class="form-control" id="admin-pass-input" required value="" placeholder="Enter Security Password" autocomplete="new-password" style="padding-right:42px;" />
              <button type="button" onclick="App.toggleAdminPasswordVisibility()" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--text-muted); cursor:pointer; font-size:1rem; padding:4px;" title="Show/Hide Password">
                <i class="fa-regular fa-eye" id="admin-pass-toggle-icon"></i>
              </button>
            </div>
          </div>
          <button type="submit" class="btn btn-maroon" id="admin-login-submit-btn" style="width:100%; margin-top:10px;">
            <i class="fa-solid fa-lock"></i> AUTHENTICATE &amp; ENTER
          </button>
          
          <div style="text-align:center; margin-top:18px; padding-top:14px; border-top:1px solid rgba(220,196,142,0.3); font-size:0.75rem; color:var(--text-muted);">
            <i class="fa-solid fa-shield-halved" style="color:var(--gold-dark); margin-right:5px;"></i>
            Protected Management Console &bull; Authorized Shop Owner Only
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- 5. ADD / EDIT PRODUCT MODAL (ADMIN) -->
  <div class="modal-backdrop" id="admin-product-modal">
    <div class="modal-dialog" style="max-width:760px;">
      <button class="modal-close-btn" onclick="App.closeModals()">&times;</button>
      <div class="enquiry-modal-body">
        <h2 style="font-family:var(--font-serif); color:var(--maroon-deep); margin-bottom:16px;" id="prod-modal-heading">Add New Masterpiece</h2>
        <form id="admin-product-form" onsubmit="App.saveProduct(event)">
          <input type="hidden" id="admin-prod-id" value="" />

          <div class="form-row">
            <div class="form-group">
              <label>Product Name *</label>
              <input type="text" class="form-control" id="ap-name" required placeholder="e.g. Royal Maroon Zardozi Bridal Lehenga" />
            </div>
            <div class="form-group">
              <label>Category *</label>
              <select class="form-control" id="ap-category" required>
                <option value="Lehenga Choli">Lehenga Choli</option>
                <option value="Sarees">Sarees</option>
                <option value="Bridal Wear">Bridal Wear</option>
                <option value="Party Wear">Party Wear</option>
                <option value="Festive Wear">Festive Wear</option>
                <option value="Designer Collections">Designer Collections</option>
              </select>
            </div>
          </div>

          <!-- DRAG & DROP PHOTO UPLOAD CONTAINER (ZERO DATABASE REQUIRED) -->
          <div class="form-group" style="margin-bottom:20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
              <label style="margin:0; font-weight:700; color:var(--maroon-deep);">
                <i class="fa-solid fa-images" style="color:var(--gold-primary); margin-right:6px;"></i> Product Photos (Drag &amp; Drop) *
              </label>
              <span class="badge-luxury badge-gold" style="font-size:0.72rem; padding:3px 8px;">
                <i class="fa-solid fa-hard-drive"></i> Stored in Browser (No Database Needed)
              </span>
            </div>

            <!-- Hidden file input placed OUTSIDE dropzone div to prevent event bubbling -->
            <input type="file" id="ap-file-input" accept="image/*" multiple style="display:none;" onchange="App.handleProductFiles(this.files)" />

            <!-- Drag and Drop Box -->
            <div class="dropzone-area" id="product-dropzone" onclick="document.getElementById('ap-file-input').click()">
              <div class="dropzone-icon">
                <i class="fa-solid fa-cloud-arrow-up"></i>
              </div>
              <div class="dropzone-text">
                <h4 style="font-family:var(--font-serif); font-size:1.1rem; color:var(--maroon-royal); margin-bottom:4px;">
                  Drag &amp; Drop Product Photos Here
                </h4>
                <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:12px;">
                  or click below to choose photos directly from your computer or mobile
                </p>
                <button type="button" class="btn btn-sm btn-gold" onclick="event.stopPropagation(); document.getElementById('ap-file-input').click()" style="padding:8px 20px; font-weight:700; box-shadow:0 3px 10px rgba(197,155,39,0.3);">
                  <i class="fa-solid fa-camera"></i> Choose Photos From Device
                </button>
                <div style="display:flex; gap:12px; font-size:0.74rem; color:var(--text-muted); justify-content:center; margin-top:12px; flex-wrap:wrap;">
                  <span><i class="fa-solid fa-circle-check" style="color:green;"></i> Auto-optimized for instant fast loading</span>
                  <span><i class="fa-solid fa-circle-check" style="color:green;"></i> Multiple photos allowed</span>
                  <span><i class="fa-solid fa-circle-check" style="color:green;"></i> JPG, PNG, WEBP</span>
                </div>
              </div>
            </div>

            <!-- Active Photos Preview Grid -->
            <div id="ap-preview-grid" class="photos-preview-grid"></div>

            <!-- Optional manual URL toggle -->
            <div style="margin-top:10px; display:flex; justify-content:space-between; align-items:center;">
              <a href="javascript:void(0)" onclick="App.toggleManualUrlInputs()" style="font-size:0.76rem; color:var(--text-muted); text-decoration:underline;">
                <i class="fa-solid fa-link"></i> Or paste image Web URL manually (optional)
              </a>
              <span id="ap-photo-counter" style="font-size:0.78rem; color:var(--maroon-royal); font-weight:700;">0 photos selected</span>
            </div>
            <div id="manual-url-container" style="display:none; margin-top:8px; padding:12px; background:#FAF7F2; border-radius:6px; border:1px dashed var(--gold-border);">
              <div class="form-group" style="margin-bottom:8px;">
                <label style="font-size:0.75rem;">Primary Image URL</label>
                <!-- type='text' prevents Chrome native URL validation from silently blocking form submission -->
                <input type="text" class="form-control" id="ap-image" placeholder="https://..." onchange="App.handleManualUrlChange()" />
              </div>
              <div class="form-group" style="margin-bottom:0;">
                <label style="font-size:0.75rem;">Secondary / Gallery Image URL</label>
                <input type="text" class="form-control" id="ap-image2" placeholder="https://..." onchange="App.handleManualUrlChange()" />
              </div>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Fabric *</label>
              <input type="text" class="form-control" id="ap-fabric" placeholder="e.g. Pure Velvet / Katan Silk" required />
            </div>
            <div class="form-group">
              <label>Work / Embroidery *</label>
              <input type="text" class="form-control" id="ap-work" placeholder="e.g. Handcrafted Zardozi & Dori" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Color</label>
              <input type="text" class="form-control" id="ap-color" placeholder="e.g. Deep Maroon & Antique Gold" />
            </div>
            <div class="form-group">
              <label>Occasion</label>
              <input type="text" class="form-control" id="ap-occasion" placeholder="e.g. Bridal / Wedding / Reception" />
            </div>
          </div>

          <div class="form-group">
            <label>Product Description</label>
            <textarea class="form-control" id="ap-desc" rows="3" placeholder="Detailed product specifications, flair meters, dupatta details..."></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Stock Status</label>
              <select class="form-control" id="ap-status">
                <option value="Available">Available (In Production)</option>
                <option value="Out of Stock">Out of Stock</option>
              </select>
            </div>
            <div class="form-group">
              <label>Price Display Mode</label>
              <select class="form-control" id="ap-price-visibility">
                <option value="enquiry">Price on Enquiry</option>
                <option value="wholesale">Contact for Wholesale Price</option>
                <option value="fixed">Show Demo Price (e.g. ₹18,500)</option>
              </select>
            </div>
          </div>

          <div style="display:flex; gap:20px; margin-bottom:16px;">
            <label style="display:flex; align-items:center; gap:8px; font-size:0.85rem; cursor:pointer;">
              <input type="checkbox" id="ap-wholesale-chk" checked /> Wholesale Available
            </label>
            <label style="display:flex; align-items:center; gap:8px; font-size:0.85rem; cursor:pointer;">
              <input type="checkbox" id="ap-retail-chk" checked /> Retail Available
            </label>
          </div>

          <button type="submit" class="btn btn-maroon" style="width:100%;">
            <i class="fa-solid fa-floppy-disk"></i> SAVE PRODUCT TO CATALOGUE
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- ==========================================================================
       CORE APPLICATION JAVASCRIPT & DATABASE ENGINE
       ========================================================================== -->
  <script>
    /**
     * PAYAL MANUFACTURING HUB - Core Application Engine
     * Completely self-contained, reactive LocalStorage database with full Customer & Admin CRUD.
     */
    const App = (function() {

