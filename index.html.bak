          <p class="wholesale-desc">
            Are you a boutique owner, retail chain, online brand, or wedding planner? Partner directly with Payal Manufacturing Hub for verified fabric consistency, flawless finishing, competitive factory rates, and dependable All-India dispatch.
          </p>

          <div class="wholesale-perks">
            <div class="perk-item">
              <i class="fa-solid fa-warehouse"></i>
              <span>Direct Factory Supply</span>
            </div>
            <div class="perk-item">
              <i class="fa-solid fa-boxes-stacked"></i>
              <span>Flexible Minimums (MOQ)</span>
            </div>
            <div class="perk-item">
              <i class="fa-solid fa-shield-halved"></i>
              <span>Strict Quality Control</span>
            </div>
            <div class="perk-item">
              <i class="fa-solid fa-truck-fast"></i>
              <span>Doorstep Parcel Delivery</span>
            </div>
          </div>

          <div style="display:flex; gap:16px; flex-wrap:wrap;">
            <a href="tel:+918209206788" class="btn btn-gold"><i class="fa-solid fa-phone"></i> Direct Call: +91 8209206788</a>
            <a href="https://wa.me/918209206788?text=Hello%20Payal%20Manufacturing%20Hub,%20I%20am%20interested%20in%20Wholesale%20partnership." target="_blank" class="btn btn-whatsapp"><i class="fa-brands fa-whatsapp"></i> WhatsApp Wholesale Team</a>
          </div>
        </div>

        <!-- Wholesale Inquiry Form -->
        <div class="wholesale-form-box">
          <h3>Wholesale Enquiry</h3>
          <p>Submit your bulk inventory requirements and our manufacturing team will provide immediate catalog sheets and price breakdowns.</p>
          <form id="wholesale-inquiry-form" onsubmit="App.handleWholesaleSubmit(event)">
            <div class="form-row">
              <div class="form-group">
                <label>Your Name *</label>
                <input type="text" class="form-control" name="customerName" required placeholder="Full Name" />
              </div>
              <div class="form-group">
                <label>Business / Boutique Name *</label>
                <input type="text" class="form-control" name="businessName" required placeholder="Business Name" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Mobile / WhatsApp Number *</label>
                <input type="tel" class="form-control" name="mobileNumber" required placeholder="+91 9876543210" />
              </div>
              <div class="form-group">
                <label>Email Address</label>
                <input type="email" class="form-control" name="emailAddress" placeholder="business@email.com" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>City *</label>
                <input type="text" class="form-control" name="city" required placeholder="City / Town" />
              </div>
              <div class="form-group">
                <label>State *</label>
                <input type="text" class="form-control" name="state" required placeholder="Maharashtra, Gujarat, etc." />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Product Category</label>
                <select class="form-control" name="productCategory">
                  <option value="All Categories">All Categories</option>
                  <option value="Lehenga Choli">Lehenga Choli</option>
                  <option value="Sarees Collections">Sarees Collections</option>
                  <option value="Bridal Wear">Bridal Wear</option>
                  <option value="Party Wear">Party Wear</option>
                  <option value="Festive Wear">Festive Wear</option>
                </select>
              </div>
              <div class="form-group">
                <label>Approximate Quantity</label>
                <select class="form-control" name="approxQuantity">
                  <option value="10 - 25 Pieces">10 - 25 Pieces (Starter)</option>
                  <option value="25 - 50 Pieces">25 - 50 Pieces</option>
                  <option value="50 - 100 Pieces">50 - 100 Pieces</option>
                  <option value="100+ Pieces">100+ Bulk Production</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label>Specific Requirements / Message</label>
              <textarea class="form-control" name="message" rows="3" placeholder="Tell us about your target price points, fabrics preferred, or specific designs required..."></textarea>
            </div>

            <button type="submit" class="btn btn-maroon" style="width:100%;">
              <i class="fa-solid fa-paper-plane"></i> SEND WHOLESALE ENQUIRY
            </button>
          </form>
        </div>
      </div>
    </section>

